---
/**
 * How confident the author is in the result, on the site's 11-point scale.
 *
 * The same 0 to 10 range as the agreement scale that propositions will use, so the whole
 * site has one legend. Two rules carried over from that scale, both of which exist because
 * they change what the numbers mean:
 *
 *   The anchors are always labelled. An unlabelled 0 to 10 reads as intensity rather than
 *   as a position, and people take 0 to mean "no opinion".
 *   There is an explicit way to decline. Without it, somebody who has not thought about it
 *   picks the middle, and a corpus of thoughtful 5s is indistinguishable from a corpus of
 *   shrugs. Declining stores null — off the scale rather than in the middle of it.
 *
 * Radios rather than a range slider. A slider has no keyboard-obvious granularity, gives no
 * way to express "not answered", and reads to a screen reader as a number with no anchors.
 */
import { CONFIDENCE } from '../lib/practice-schema';

interface Props {
  name: string;
}

const { name } = Astro.props;
const points = Array.from(
  { length: CONFIDENCE.max - CONFIDENCE.min + 1 },
  (_, i) => CONFIDENCE.min + i,
);
---

<fieldset class="scale">
  <legend class="visually-hidden">Confidence in the result</legend>

  <div class="scale__row">
    <span class="scale__anchor">0 — no confidence</span>
    <span class="scale__anchor scale__anchor--end">10 — complete confidence</span>
  </div>

  <div class="scale__points">
    {
      points.map((point) => (
        <label class="scale__point" for={`${name}-${point}`}>
          <input
            class="scale__input"
            type="radio"
            id={`${name}-${point}`}
            name={name}
            value={String(point)}
          />
          <span class="scale__number">{point}</span>
        </label>
      ))
    }
  </div>

  <div class="checkbox scale__decline">
    <input class="checkbox__input" type="radio" id={`${name}-none`} name={name} value="" checked />
    <label class="checkbox__label" for={`${name}-none`}>
      I would rather not put a number on it
    </label>
  </div>
</fieldset>

<style>
  .scale {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .scale__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-block-end: var(--space-3xs);
    color: var(--ink-muted);
    font-size: var(--size-2);
  }

  .scale__anchor--end {
    text-align: right;
  }

  .scale__points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs);
  }

  .scale__point {
    flex: 1 1 2.25rem;
    cursor: pointer;
  }

  .scale__input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* A score is a number a machine parses, so it is mono, like every other one here. */
  .scale__number {
    display: block;
    padding-block: var(--space-2xs);
    border: var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--size-2);
    text-align: center;
  }

  .scale__point:has(.scale__input:checked) .scale__number {
    border-width: var(--border-width-thick);
    border-color: var(--ink);
    background-color: var(--accent-wash);
    padding-block: calc(var(--space-2xs) - 1px);
    font-weight: var(--weight-semibold);
  }

  .scale__point:has(.scale__input:focus-visible) .scale__number {
    outline: var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .scale__decline {
    margin-block-start: var(--space-sm);
  }
</style>
