---
/**
 * The contributions on one debate, as two views of the same rows.
 *
 * Why this is not `CommentThread.astro`
 * -------------------------------------
 * That component's header says a thread is a thread and that splitting the two would guarantee
 * they drift, and it was right for as long as the two surfaces were the same thing: a list of
 * remarks under a page, threaded one level, newest at the bottom.
 *
 * They are no longer the same thing. **A debate is a map of positions, not a feed of comments.**
 * Reading order here is claim, then distribution, then contributions grouped by the position
 * they were written from, then one contribution — and none of that has an analogue on a report,
 * where the thread is a discussion of one specific account and threading is correct. This
 * surface has twelve groups, two views, a sort control, no replies, no nesting, and no badges.
 * Branching `CommentThread.astro` on `parentType` would have meant two mutually exclusive
 * markup trees and two client scripts in one file, with every shared selector a way to change
 * how a report thread renders by accident.
 *
 * So the split is deliberate and the boundary is drawn where the two genuinely differ:
 * **rendering**. Everything either surface *does* still comes from `src/lib/comments.ts` —
 * reading the corpus, editing, deleting, flagging — so the behaviour cannot drift even though
 * the markup has. `CommentThread.astro` is untouched by this work, and its `:scope >`
 * discipline stays exactly as it is: report threads still nest, and a comment still contains
 * its replies, so a descendant selector there still finds the wrong row.
 *
 * What the zero-JavaScript case is
 * --------------------------------
 * **Open a position, read those contributions.** The selector is native `<details>` — one per
 * family, each holding one per position — and the contributions are inside them rather than
 * filtered into view by script. Closed by default, so the view starts empty and nothing is
 * revealed until the reader chooses a position, which is the whole point of the grouping.
 *
 * `:has()` hides the prompt line once anything is open, so even that much needs no script.
 *
 * The enhancement is: exclusive selection, the URL, opening a whole family at once, landing on
 * the reader's own position, the sort control, and the flat view. A reader with no JavaScript
 * loses the flat view and keeps the section.
 *
 * Why a contribution is rendered once
 * -----------------------------------
 * The flat view moves the same `<li>` nodes rather than holding a second copy of them. Two
 * copies would mean two elements carrying one `id`, and `#comment-<id>` is a real address —
 * the activity feed builds it to point somebody at the contribution they were told about.
 * `data-position` on each node is what lets the move be reversed.
 */
import Contribution from './Contribution.astro';
import { renderMarkdown } from '../lib/markdown';
import {
  FAMILIES,
  OFF_SCALE_KEY,
  OFF_SCALE_LABEL,
  UNRECORDED_KEY,
  UNRECORDED_LABEL,
  groupKeyFor,
  keysInFamily,
} from '../lib/positions';
import type { Comment } from '../lib/comments';

interface Props {
  parentId: string;
  /** Every contribution on this debate, flat. Historical replies included — see below. */
  contributions: readonly Comment[];
  /** This page's own title and URL, so a passage selected here knows where it came from. */
  title: string;
  href: string;
}

const { parentId, contributions, title, href }: Props = Astro.props;

/**
 * Newest first, which is the default sort.
 *
 * Flat, and that is the point: **replies are gone on debates.** The database refuses a new one,
 * so any `inReplyTo` still in the corpus is historical — and it is rendered here in the list
 * like anything else rather than hidden, because a remark somebody wrote is not a schema
 * migration's to withdraw. It simply loses its indent.
 */
const ordered = [...contributions].sort((a, b) => b.createdAt.localeCompare(a.createdAt));

/** Rendered once each, up front, because `set:html` cannot await. */
const rendered = new Map<string, string>();
for (const contribution of ordered) {
  rendered.set(
    contribution.id,
    contribution.deletedAt ? '' : await renderMarkdown(contribution.body),
  );
}

/** Grouped by the position each was written from. `groupKeyFor` is the one place that decides,
 *  and it is what puts the off-scale answers in their own group rather than at 5. */
const groups = new Map<string, Comment[]>();
for (const contribution of ordered) {
  const key = groupKeyFor(contribution.agreementScore, contribution.positionKnown);
  const bucket = groups.get(key);
  if (bucket) bucket.push(contribution);
  else groups.set(key, [contribution]);
}

const countIn = (key: string): number => groups.get(key)?.length ?? 0;
const countInFamily = (familyKey: string): number =>
  keysInFamily(familyKey).reduce((total, key) => total + countIn(key), 0);

const total = ordered.length;
const offScaleCount = countIn(OFF_SCALE_KEY);
const unrecordedCount = countIn(UNRECORDED_KEY);
---

<section
  class="contributions"
  id="contributions"
  data-contributions
  data-parent-id={parentId}
  data-node-title={title}
  data-node-href={href}
>
  <div class="contributions__head">
    <h2>Contributions</h2>
    <p class="contributions__count meta" data-total>
      {total === 0
        ? 'No contributions yet'
        : `${total} contribution${total === 1 ? '' : 's'}`}
    </p>
  </div>

  {/* Both controls are `hidden` in the markup and revealed by script, because both are the
      enhancement: without JavaScript there is one view and one order, and a control that does
      nothing is worse than an absent one. `[hidden]` is honoured here because base.css carries
      the project's single `!important` for exactly this — no second rule is added below. */}
  <div class="contributions__controls">
    <div class="viewswitch" role="group" aria-label="How to read the contributions" data-views hidden>
      <button class="viewswitch__button" type="button" data-view-button="position" aria-pressed="true">
        By position
      </button>
      <button class="viewswitch__button" type="button" data-view-button="all" aria-pressed="false">
        All contributions
      </button>
    </div>

    <p class="contributions__sort" data-sort-wrap hidden>
      <label class="meta" for="contributions-sort">Order</label>
      <select class="field__control field__control--inline" id="contributions-sort" data-sort>
        <option value="recent">Most recent</option>
        <option value="endorsed">Most endorsed</option>
      </select>
    </p>
  </div>

  {
    total === 0 ? (
      /* One of the two empty states, and the one that needs no aggregate to be sure of. The
         other — people answered at this position and none of them wrote anything — is a fact
         about the distribution, so it is filled in per position by script once the reader has
         answered and the histogram is available. See `annotate()` in the script below. */
      <p class="contributions__empty" data-empty-debate>
        Nobody has written a contribution yet. The useful first one says which position you
        argue from and why — a reason somebody at the other end of the scale could engage with.
      </p>
    ) : (
      <>
        <div class="view" data-view="position">
          {/* Hidden by `:has()` the moment any position is open. No script involved: the
              prompt is only true while the view really is empty. */}
          <p class="contributions__prompt" data-prompt>
            Choose a position to read what those participants wrote.
          </p>

          {FAMILIES.map((family) => (
            <details class="family" data-family={family.key}>
              <summary class="family__summary">
                <span class="family__label">{family.label}</span>
                <span class="family__range meta">
                  {family.from === family.to ? family.from : `${family.from}–${family.to}`}
                </span>
                <span class="family__count meta" data-family-count>
                  {countInFamily(family.key)}
                </span>
              </summary>

              <div class="family__body">
                {keysInFamily(family.key).map((key) =>
                  countIn(key) === 0 ? (
                    /* Shown but inert. A position nobody has written from is part of the shape
                       of the debate, and hiding it would make the scale look narrower than it
                       is — but there is nothing to open, so it is not a disclosure. */
                    <p class="position position--inert" data-position-group={key} data-inert>
                      <span class="position__score">{key}</span>
                      <span class="position__note meta" data-group-note>
                        No contributions at this position
                      </span>
                    </p>
                  ) : (
                    <details class="position" data-position-group={key}>
                      <summary class="position__summary">
                        <span class="position__score">{key}</span>
                        <span class="position__count meta">
                          {countIn(key)}{' '}
                          {countIn(key) === 1 ? 'contribution' : 'contributions'}
                        </span>
                      </summary>

                      <ol class="contribution-list" data-group-list={key} role="list">
                        {(groups.get(key) ?? []).map((contribution) => (
                          <Contribution
                            contribution={contribution}
                            html={rendered.get(contribution.id) ?? ''}
                            positionKey={key}
                          />
                        ))}
                      </ol>

                      {/* The seam for prompt 6, and deliberately empty. Writing a contribution
                          belongs in the reader's own position group, below what is already
                          there, collapsed behind an explicit control — so there is nothing
                          always-visible here to have to remove later. */}
                      <div class="position__compose" data-compose-seam={key} hidden />
                    </details>
                  ),
                )}
              </div>
            </details>
          ))}

          {/* The twelfth group, outside the five families and after them, because it is off the
              scale rather than at one end of it. On a claim about formalisation "I cannot judge
              the cost, and that is the whole disagreement" is frequently the most honest thing
              on the page; filing it at the neutral 5 would assert a position its author
              explicitly declined to take. */}
          {offScaleCount === 0 ? (
            <p class="position position--inert position--offscale" data-position-group={OFF_SCALE_KEY} data-inert>
              <span class="position__offscale-label">{OFF_SCALE_LABEL}</span>
              <span class="position__note meta" data-group-note>No contributions</span>
            </p>
          ) : (
            <details class="position position--offscale" data-position-group={OFF_SCALE_KEY}>
              <summary class="position__summary">
                <span class="position__offscale-label">{OFF_SCALE_LABEL}</span>
                <span class="position__count meta">
                  {offScaleCount} {offScaleCount === 1 ? 'contribution' : 'contributions'}
                </span>
              </summary>

              <p class="position__aside">
                Off the scale, not in the middle of it. These are people who were asked and
                declined to put a number on it.
              </p>

              <ol class="contribution-list" data-group-list={OFF_SCALE_KEY} role="list">
                {(groups.get(OFF_SCALE_KEY) ?? []).map((contribution) => (
                  <Contribution
                    contribution={contribution}
                    html={rendered.get(contribution.id) ?? ''}
                    positionKey={OFF_SCALE_KEY}
                  />
                ))}
              </ol>

              <div class="position__compose" data-compose-seam={OFF_SCALE_KEY} hidden />
            </details>
          )}

          {/* Rendered only when it has something in it, which on a current export is never.
              These are contributions from a `data/` written before the score column existed —
              see UNRECORDED_KEY. They cannot go in the off-scale group, because that group
              asserts its members were asked and declined, and an older file is no evidence for
              that. */}
          {unrecordedCount > 0 && (
            <details class="position position--offscale" data-position-group={UNRECORDED_KEY}>
              <summary class="position__summary">
                <span class="position__offscale-label">{UNRECORDED_LABEL}</span>
                <span class="position__count meta">
                  {unrecordedCount} {unrecordedCount === 1 ? 'contribution' : 'contributions'}
                </span>
              </summary>

              <p class="position__aside">
                Written before the site recorded which position a contribution argued from.
                They will move to their own positions at the next nightly export.
              </p>

              <ol class="contribution-list" data-group-list={UNRECORDED_KEY} role="list">
                {(groups.get(UNRECORDED_KEY) ?? []).map((contribution) => (
                  <Contribution
                    contribution={contribution}
                    html={rendered.get(contribution.id) ?? ''}
                    positionKey={UNRECORDED_KEY}
                  />
                ))}
              </ol>
            </details>
          )}
        </div>

        {/* The flat view. Empty in the markup: script moves the same nodes into it, so there is
            never a second element carrying a contribution's id. Without JavaScript this stays
            empty and hidden, and the by-position view is the whole section. */}
        <div class="view" data-view="all" hidden>
          <ol class="contribution-list" data-flat-list role="list" />
        </div>
      </>
    )
  }
</section>

<script>
  import {
    deleteComment,
    editComment,
    fileFlag,
    FLAG_REASONS,
    type FlagReason,
  } from '../lib/comments';
  import { hideStatus, setBusy, showStatus } from '../lib/forms';
  import { loadProfile, mayPost } from '../lib/profile';
  import {
    FAMILIES,
    OFF_SCALE_KEY,
    UNRECORDED_KEY,
    allGroupKeys,
    isFamilyKey,
    keysInFamily,
  } from '../lib/positions';
  import { startSession, subscribeToSession } from '../lib/session';

  const sectionRoot = document.querySelector<HTMLElement>('[data-contributions]');

  if (sectionRoot) {
    /**
     * Aliased, and this is the trap rather than a habit.
     *
     * TypeScript keeps a `const` narrowing inside arrow functions and drops it inside hoisted
     * `function` declarations: the declaration is lifted to the top of the block, so the
     * compiler will not assume the `if` above has run. Every `root.` inside a `function` below
     * would otherwise be an error — and the build stays green through exactly that, which is
     * why `astro check` is the gate and not `astro build`.
     */
    const root = sectionRoot;

    // ── The two views ─────────────────────────────────────────────────────────────────

    const views = root.querySelector<HTMLElement>('[data-views]');
    const positionView = root.querySelector<HTMLElement>('[data-view="position"]');
    const flatView = root.querySelector<HTMLElement>('[data-view="all"]');
    const flatList = root.querySelector<HTMLOListElement>('[data-flat-list]');
    const sortWrap = root.querySelector<HTMLElement>('[data-sort-wrap]');
    const sortControl = root.querySelector<HTMLSelectElement>('[data-sort]');

    // Both controls exist only once script is running, which is what makes the zero-JS case
    // honest: one view, one order, no dead controls.
    if (views) views.hidden = false;
    if (sortWrap) sortWrap.hidden = false;

    /** Every contribution node, held by identity rather than re-queried, because the flat view
     *  moves them out of their groups and a selector scoped to a group would then miss them. */
    const items = [...root.querySelectorAll<HTMLLIElement>('[data-contribution]')];

    let view: 'position' | 'all' = 'position';

    function showView(next: 'position' | 'all'): void {
      view = next;

      if (positionView) positionView.hidden = next !== 'position';
      if (flatView) flatView.hidden = next !== 'all';

      for (const button of root.querySelectorAll<HTMLButtonElement>('[data-view-button]')) {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.viewButton === next),
        );
      }

      if (next === 'all') {
        // Moved, not copied. See the header: two nodes with one id would break `#comment-<id>`,
        // which the activity feed hands out as a real address.
        if (flatList) for (const item of items) flatList.append(item);
      } else {
        for (const item of items) {
          const list = root.querySelector<HTMLOListElement>(
            `[data-group-list="${item.dataset.position}"]`,
          );
          if (list) list.append(item);
        }
      }

      sort();
      writeUrl();
    }

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-view-button]')) {
      button.addEventListener('click', () => {
        showView(button.dataset.viewButton === 'all' ? 'all' : 'position');
      });
    }

    // ── Sorting ───────────────────────────────────────────────────────────────────────
    // Most recent, or most endorsed. **No rank numbers and no position badges**: this is an
    // order, not a leaderboard, so nothing on a contribution says where it came in.

    function sort(): void {
      const mode = sortControl?.value === 'endorsed' ? 'endorsed' : 'recent';

      const lists = [
        ...root.querySelectorAll<HTMLOListElement>('[data-group-list]'),
        ...(flatList ? [flatList] : []),
      ];

      for (const list of lists) {
        const children = [...list.querySelectorAll<HTMLLIElement>(':scope > [data-contribution]')];

        children.sort((a, b) => {
          if (mode === 'endorsed') {
            const difference =
              Number(b.dataset.endorsements ?? 0) - Number(a.dataset.endorsements ?? 0);
            // Newest first under an equal count, so the order is total rather than whatever
            // the sort happened to do with the ties.
            if (difference !== 0) return difference;
          }

          return (b.dataset.commentCreated ?? '').localeCompare(a.dataset.commentCreated ?? '');
        });

        for (const child of children) list.append(child);
      }
    }

    sortControl?.addEventListener('change', () => {
      sort();
      writeUrl();
    });

    // ── Selection ─────────────────────────────────────────────────────────────────────
    // Exclusive: picking a position closes the previous one, because the view is a map and two
    // groups open at once is the chronological wall it exists not to be.

    function groupFor(key: string): HTMLDetailsElement | null {
      return root.querySelector<HTMLDetailsElement>(
        `details[data-position-group="${key}"]`,
      );
    }

    /** Every group the exclusive selection has to be able to close, which is the twelve plus
     *  the transitional unrecorded one. `allGroupKeys()` stays the twelve the spec describes. */
    function selectableKeys(): string[] {
      return [...allGroupKeys(), UNRECORDED_KEY];
    }

    /**
     * True while `select()` is rewriting the disclosures.
     *
     * Setting `.open` fires that element's own `toggle` event, and the handlers below call
     * `select()` — so without this, opening a family opened its whole band and then the first
     * child's toggle re-entered and closed every sibling it had just opened. The guard is on
     * the listeners rather than on the setter because `toggle` is also how a reader's own click
     * arrives, and those must still be honoured.
     */
    let applying = false;

    function select(key: string, options: { url?: boolean } = {}): void {
      const wanted = isFamilyKey(key) ? keysInFamily(key) : [key];

      applying = true;

      for (const other of selectableKeys()) {
        const group = groupFor(other);
        if (group) group.open = wanted.includes(other);
      }

      // A family selection opens its own disclosure too, or its positions would be revealed
      // inside a closed parent.
      for (const family of FAMILIES) {
        const element = root.querySelector<HTMLDetailsElement>(
          `details[data-family="${family.key}"]`,
        );
        if (!element) continue;

        element.open = isFamilyKey(key)
          ? family.key === key
          : keysInFamily(family.key).includes(key);
      }

      applying = false;

      if (options.url !== false) writeUrl(key);
    }

    /** The reader's own group, opened for them. A reader who has already answered lands on
     *  their own position — including the off-scale group, if that is where they are. */
    function selectOwn(score: number | null): void {
      select(score === null ? OFF_SCALE_KEY : String(score));
    }

    // Exclusive selection, and the family-opens-its-band behaviour, wired onto the native
    // disclosures rather than replacing them. `toggle` fires for keyboard and mouse alike.
    for (const key of selectableKeys()) {
      const group = groupFor(key);
      group?.addEventListener('toggle', () => {
        if (applying) return;
        if (group.open) select(key);
        // Closing the last open group selects nothing, so the address bar should say nothing
        // rather than keep pointing at a position the reader has just closed.
        else if (currentKey() === null) writeUrl(null);
      });
    }

    for (const family of FAMILIES) {
      const element = root.querySelector<HTMLDetailsElement>(
        `details[data-family="${family.key}"]`,
      );

      element?.addEventListener('toggle', () => {
        if (applying) return;

        // Opening a family opens everything in its band, which is what makes the heading a
        // selector rather than only a container. Closing it selects nothing.
        if (element.open) {
          if (!keysInFamily(family.key).some((key) => groupFor(key)?.open)) {
            select(family.key);
          }
        } else {
          // Guarded for the same reason: each of these setters fires a child's toggle, and
          // letting them all run would clear the address bar once per position in the band.
          applying = true;
          for (const key of keysInFamily(family.key)) {
            const group = groupFor(key);
            if (group) group.open = false;
          }
          applying = false;

          writeUrl(null);
        }
      });
    }

    function currentKey(): string | null {
      for (const key of selectableKeys()) {
        if (groupFor(key)?.open) return key;
      }
      return null;
    }

    // ── The URL ───────────────────────────────────────────────────────────────────────
    // So a position is linkable and survives being copied, bookmarked or arrived at from
    // somewhere else. `replaceState`, like the listings, because a selection is not a
    // navigation.

    function writeUrl(key?: string | null): void {
      const url = new URL(window.location.href);
      const selected = key === undefined ? currentKey() : key;

      if (view === 'all') url.searchParams.set('view', 'all');
      else url.searchParams.delete('view');

      if (selected && view === 'position') url.searchParams.set('position', selected);
      else url.searchParams.delete('position');

      if (sortControl && sortControl.value !== 'recent') {
        url.searchParams.set('order', sortControl.value);
      } else {
        url.searchParams.delete('order');
      }

      window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
    }

    function readUrl(): void {
      const params = new URLSearchParams(window.location.search);

      const order = params.get('order');
      if (sortControl && order === 'endorsed') sortControl.value = order;

      if (params.get('view') === 'all') showView('all');
      else sort();

      const position = params.get('position');
      if (position && view === 'position') select(position, { url: false });
    }

    readUrl();

    /**
     * A fragment pointing into a closed group.
     *
     * `#comment-<id>` is handed out by the activity feed, and the contribution it names is
     * inside a `<details>` that starts closed. Browsers now open ancestor disclosures for a
     * fragment target themselves, but not all of them and not on every version — and the group
     * also has to become the *selected* one, which no browser knows to do.
     */
    function openHashTarget(): void {
      const id = window.location.hash.replace('#', '');
      if (!id) return;

      const target = document.getElementById(id);
      const key = target?.closest<HTMLElement>('[data-contribution]')?.dataset.position;
      if (!key) return;

      select(key, { url: false });
      target?.scrollIntoView({ block: 'center' });
    }

    openHashTarget();
    window.addEventListener('hashchange', openHashTarget);

    // ── What the reader may do to their own ───────────────────────────────────────────
    // Carried over rather than dropped. Editing, deleting and flagging exist on this surface
    // today and removing a flag path silently would be the worst of the three.

    let viewerId: string | null = null;

    subscribeToSession((state) => {
      if (state.status === 'loading') return;

      viewerId = state.status === 'signed-in' ? state.userId : null;
      void applyViewer();
    });

    void startSession();

    async function applyViewer(): Promise<void> {
      const id = viewerId;
      const allowed = id ? await loadProfile(id).then((r) => r.ok && mayPost(r.value)) : false;

      for (const item of items) {
        const mine = !!id && item.dataset.commentAuthor === id;
        const removed = !!item.querySelector(':scope > .contribution__removed');

        // `:scope >` throughout, and it stays even though a debate contribution can no longer
        // contain another. The rule is the discipline rather than the current shape of the
        // data: historical replies are rendered in this list, and the day something nests here
        // again a descendant selector would silently find the wrong row.
        const actions = item.querySelector<HTMLElement>(':scope > [data-comment-actions]');
        if (!actions) continue;

        show(actions, 'edit', mine && !removed);
        show(actions, 'delete', mine && !removed);
        show(actions, 'flag', allowed && !mine && !removed);
      }
    }

    function show(actions: HTMLElement, action: string, visible: boolean): void {
      const button = actions.querySelector<HTMLElement>(`[data-action="${action}"]`);
      if (button) button.hidden = !visible;
    }

    root.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action]');
      if (!button) return;

      const item = button.closest<HTMLElement>('[data-contribution]');
      if (!item) return;

      if (button.dataset.action === 'edit') openEditor(item);
      if (button.dataset.action === 'delete') void remove(item);
      if (button.dataset.action === 'flag') openFlag(item);
    });

    /** The one slot per contribution, found with `:scope >` for the reason above. */
    function slotFor(item: HTMLElement): HTMLElement | null {
      return item.querySelector<HTMLElement>(':scope > [data-comment-slot]');
    }

    function openEditor(item: HTMLElement): void {
      const slot = slotFor(item);
      const body = item.querySelector<HTMLElement>(':scope > [data-comment-body]');
      if (!slot || !body) return;

      const id = item.dataset.commentId!;
      slot.replaceChildren();

      const form = document.createElement('form');
      form.className = 'form';
      form.noValidate = true;

      const area = document.createElement('textarea');
      area.className = 'field__control';
      area.rows = 5;
      area.maxLength = 5000;
      area.value = body.dataset.source ?? body.textContent?.trim() ?? '';
      area.setAttribute('aria-label', 'Edit your contribution');

      const actions = document.createElement('div');
      actions.className = 'actions';

      const save = document.createElement('button');
      save.className = 'button button--primary';
      save.type = 'submit';
      save.textContent = 'Save';

      const cancel = document.createElement('button');
      cancel.className = 'button button--quiet';
      cancel.type = 'button';
      cancel.textContent = 'Cancel';
      cancel.addEventListener('click', () => slot.replaceChildren());

      const status = document.createElement('p');
      status.className = 'form-status';
      status.setAttribute('role', 'status');
      status.tabIndex = -1;
      status.hidden = true;

      actions.append(save, cancel);
      form.append(area, actions, status);

      const note = document.createElement('p');
      note.className = 'field__hint';
      note.textContent =
        'Twenty-four hours, and it closes as soon as somebody says this captures their view — ' +
        'they agreed to the words in front of them. After that, answer again and write a new ' +
        'contribution; this one stays where it is.';
      form.append(note);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        hideStatus(status);

        setBusy(save, true, 'Saving…');
        const result = await editComment(id, area.value);
        setBusy(save, false);

        if (!result.ok) {
          showStatus(status, 'error', result.message);
          return;
        }

        // The markdown is set at build time, so what the browser can honestly show is the
        // source it just saved, marked as unset. Rendering it here would mean shipping a
        // parser and a copy of KaTeX to every reader.
        body.textContent = area.value;
        body.dataset.source = area.value;
        body.classList.add('contribution__body--unset');
        slot.replaceChildren();
      });

      slot.append(form);
      area.focus();
    }

    async function remove(item: HTMLElement): Promise<void> {
      const slot = slotFor(item);
      if (!slot) return;

      const id = item.dataset.commentId!;

      slot.replaceChildren();

      const panel = document.createElement('div');
      panel.className = 'panel';

      const question = document.createElement('p');
      question.textContent =
        'Delete this contribution? The text goes for good and your name comes off it. The ' +
        'position it was written from stays in the distribution — a deleted contribution would ' +
        'otherwise take a count with it.';

      const actions = document.createElement('div');
      actions.className = 'actions';

      const confirm = document.createElement('button');
      confirm.className = 'button button--primary';
      confirm.type = 'button';
      confirm.textContent = 'Delete';

      const cancel = document.createElement('button');
      cancel.className = 'button button--quiet';
      cancel.type = 'button';
      cancel.textContent = 'Keep it';
      cancel.addEventListener('click', () => slot.replaceChildren());

      const status = document.createElement('p');
      status.className = 'form-status';
      status.setAttribute('role', 'status');
      status.tabIndex = -1;
      status.hidden = true;

      confirm.addEventListener('click', async () => {
        hideStatus(status);
        setBusy(confirm, true, 'Deleting…');
        const result = await deleteComment(id);
        setBusy(confirm, false);

        if (!result.ok) {
          showStatus(status, 'error', result.message);
          return;
        }

        window.location.reload();
      });

      actions.append(confirm, cancel);
      panel.append(question, actions, status);
      slot.append(panel);
    }

    function openFlag(item: HTMLElement): void {
      const slot = slotFor(item);
      if (!slot) return;

      const id = item.dataset.commentId!;
      slot.replaceChildren();

      const form = document.createElement('form');
      form.className = 'form';
      form.noValidate = true;

      /* A bespoke fieldset rather than `Field.astro`, and not only because this is script:
         that component renders its own control from a `type` prop and has no `input` slot, so
         a vocabulary passed to it as slotted content is dropped without a warning. Radios here
         are a fieldset, as they are in ReportFields.astro. */
      const fieldset = document.createElement('fieldset');
      fieldset.className = 'choices';

      const legend = document.createElement('legend');
      legend.className = 'field__label';
      legend.textContent = 'What is wrong with it?';
      fieldset.append(legend);

      for (const reason of FLAG_REASONS) {
        const label = document.createElement('label');
        label.className = 'choices__option';

        const input = document.createElement('input');
        input.type = 'radio';
        input.name = `flag-${id}`;
        input.value = reason.value;

        const text = document.createElement('span');
        text.textContent = reason.label;

        label.append(input, text);
        fieldset.append(label);
      }

      const detail = document.createElement('textarea');
      detail.className = 'field__control';
      detail.rows = 3;
      detail.maxLength = 1000;
      detail.setAttribute('aria-label', 'Anything the moderator should know (optional)');

      const actions = document.createElement('div');
      actions.className = 'actions';

      const send = document.createElement('button');
      send.className = 'button button--primary';
      send.type = 'submit';
      send.textContent = 'Flag it';

      const cancel = document.createElement('button');
      cancel.className = 'button button--quiet';
      cancel.type = 'button';
      cancel.textContent = 'Cancel';
      cancel.addEventListener('click', () => slot.replaceChildren());

      const status = document.createElement('p');
      status.className = 'form-status';
      status.setAttribute('role', 'status');
      status.tabIndex = -1;
      status.hidden = true;

      actions.append(send, cancel);
      form.append(fieldset, detail, actions, status);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        hideStatus(status);

        const chosen = form.querySelector<HTMLInputElement>('input[type="radio"]:checked');
        if (!chosen || !viewerId) {
          showStatus(status, 'error', 'Choose what is wrong with it first.');
          return;
        }

        setBusy(send, true, 'Sending…');
        const result = await fileFlag(
          'comment',
          id,
          viewerId,
          chosen.value as FlagReason,
          detail.value,
        );
        setBusy(send, false);

        if (!result.ok) {
          showStatus(status, 'error', result.message);
          return;
        }

        slot.replaceChildren();
        const done = document.createElement('p');
        done.className = 'field__hint';
        done.textContent =
          'Flagged. A moderator will decide and will write an explanation you can read.';
        slot.append(done);
      });

      slot.append(form);
    }

    // ── What only the distribution knows ─────────────────────────────────────────────
    /**
     * "People answered at this position and none of them wrote anything" is the interesting
     * empty state, and it is a fact about the **distribution** — so it cannot be in the page
     * source. The histogram is fetched after the reader has answered, precisely so that it is
     * not, and that rule is not weakened here to make a nicer empty state.
     *
     * So the debate page tells this section, once, on the same event that reveals the chart.
     * Until then an empty position says only that it has no contributions, which is all the
     * page can honestly claim.
     */
    document.addEventListener('mathemact:rated', (event) => {
      const detail = (event as CustomEvent).detail as {
        histogram?: readonly number[];
        noOpinionCount?: number;
        score?: number | null;
        rated?: boolean;
      };

      annotate(detail.histogram, detail.noOpinionCount);
      if (detail.rated) selectOwn(detail.score ?? null);
    });

    function annotate(histogram?: readonly number[], noOpinionCount?: number): void {
      if (!histogram) return;

      for (const key of allGroupKeys()) {
        const answered =
          key === OFF_SCALE_KEY ? (noOpinionCount ?? 0) : (histogram[Number(key)] ?? 0);

        const note = root.querySelector<HTMLElement>(
          `[data-position-group="${key}"] [data-group-note]`,
        );
        if (!note) continue;

        // Only where there is nothing to read. A position with contributions says nothing
        // about how many people are there — the count in its summary is contributions, and
        // conflating the two would be the page reporting the distribution twice in two units.
        note.textContent =
          answered === 0
            ? 'Nobody answered here'
            : answered === 1
              ? '1 person answered here and wrote nothing'
              : `${answered} people answered here and none of them wrote anything`;
      }
    }
  }
</script>

