---
/**
 * Entry listing, filterable by category.
 *
 * Unreachable entries (link_status = 'unreachable') are always shown — never silently
 * hidden — but sorted last and visibly marked. A broken link is a fact in the corpus.
 *
 * Static build from data/network.json (written nightly by scripts/export.mjs).
 */
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { exportedAt } from '../../lib/manifest';
import { path } from '../../lib/paths';
import { CATEGORIES, categoryLabel, listNetwork } from '../../lib/network';
import type { NetworkCategory } from '../../lib/network';

const all = listNetwork();

const usedCategories = new Set(all.map((r) => r.category));
const categories = CATEGORIES.filter((c) => usedCategories.has(c.value));
---

<Base
  title="Network"
  description="Community-curated links to AI tools, educational materials, and guidelines for mathematicians."
>
  <div class="shell corpus network-corpus" data-corpus data-exported-at={exportedAt() ?? ''}>
    <header class="corpus__header">
      <h1>Network</h1>
      <p class="corpus__lead">
        Community-curated links to tools, courses, libraries, and guidelines. Moderated
        before publication and checked monthly.
      </p>
    </header>

    {/* Above the listing and outside the branch, so it is in the same place whether
        anything has been published or not. It used to be at the foot of the page, below a
        list that grows without limit. */}
    <p class="corpus__action">
      <a class="button button--primary" href={path('/network/new/')}>Submit an entry</a>
    </p>

    {all.length === 0 ? (
      <p class="corpus__empty">No entries have been published yet.</p>
    ) : (
      <div class="listing">
        <aside class="listing__filters" aria-label="Filter entries">
          <form method="get" action={path('/network/')}>
            <fieldset class="filter-set">
              <legend class="filter-set__legend">Category</legend>
              <label class="filter-chip">
                <input type="radio" name="cat" value="" />
                <span>All</span>
              </label>
              {categories.map((c) => (
                <label class="filter-chip">
                  <input type="radio" name="cat" value={c.value} />
                  <span>{c.label}</span>
                </label>
              ))}
            </fieldset>
            <button class="button button--secondary filter-apply" type="submit">Apply</button>
          </form>
        </aside>

        <section class="listing__results" aria-label="Network" aria-live="polite">
          <p class="listing__count" data-count aria-live="polite">
            {all.length} {all.length === 1 ? 'entry' : 'entries'}
          </p>

          <ul class="entry-list" data-entry-list role="list">
            {/* Reachable entries first, then unreachable — sorted by created_at desc within each group. */}
            {[
              ...all.filter((r) => r.linkStatus !== 'unreachable').sort((a, b) => b.createdAt.localeCompare(a.createdAt)),
              ...all.filter((r) => r.linkStatus === 'unreachable').sort((a, b) => b.createdAt.localeCompare(a.createdAt)),
            ].map((entry) => (
              <li
                class="entry-card"
                data-category={entry.category}
                data-unreachable={entry.linkStatus === 'unreachable' ? 'true' : undefined}
              >
                <div class="entry-card__head">
                  <a
                    class="entry-card__title"
                    href={entry.url}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {entry.title}
                  </a>
                  {entry.linkStatus === 'unreachable' && (
                    <span class="entry-card__unreachable" title="This link was unreachable at the last monthly check">
                      Link may be broken
                    </span>
                  )}
                  {entry.linkStatus === 'redirected' && (
                    <span class="entry-card__redirected">Redirects</span>
                  )}
                </div>

                <p class="entry-card__url mono">{entry.urlNormalised}</p>

                <p class="entry-card__description">{entry.description}</p>

                <p class="entry-card__relevance">{entry.relevance}</p>

                <div class="entry-card__meta">
                  <span class="entry-card__category mono">
                    {categoryLabel(entry.category as NetworkCategory)}
                  </span>
                  {entry.submitter && (
                    <Fragment>
                      <span class="entry-card__submitter">
                        Submitted by{' '}
                        <a href={path(`/authors/${entry.submitter.id}/`)}>
                          {entry.submitter.displayName}
                          {entry.submitter.isPseudonym && ' (a pseudonym)'}
                        </a>
                      </span>
                      {/* Compact, and a sibling rather than a child of the line above. The
                          full badge block is a bordered card that also states Registered,
                          which on every row of a list would be the loudest thing on the
                          page — the same reasoning that gave comment headers this variant.
                          Outside the span because `.badge-line` is a <p>, which is not
                          phrasing content and may not sit inside one. */}
                      <Badges institution={entry.submitter.institution} compact />
                    </Fragment>
                  )}
                  {!entry.submitter && (
                    <span class="entry-card__submitter entry-card__erased">
                      Submitter since erased
                    </span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      </div>
    )}

    {/* Fresh entries link directly to the external URL — no view page needed, because
        an entry is a pointer to an external thing, not a page on this site. */}
    <template data-fresh-entry>
      <li class="entry-card" data-fresh>
        <p class="card__fresh">
          <span class="mono">new since the last build</span>
        </p>
        <div class="entry-card__head">
          <a class="entry-card__title" data-title rel="noopener noreferrer" target="_blank"></a>
        </div>
        <p class="entry-card__url mono" data-url></p>
        <p class="entry-card__description" data-description></p>
        <p class="entry-card__relevance" data-relevance></p>
        <div class="entry-card__meta">
          <span class="entry-card__category mono" data-category-label></span>
        </div>
      </li>
    </template>
  </div>
</Base>

<script>
  /**
   * Client-side category filtering. The URL is the state: selecting a category
   * updates ?cat= and the page reloads, making filtered views linkable.
   * JS also hides non-matching cards without a round trip for fast switching.
   */
  const params = new URLSearchParams(window.location.search);
  const activeCat = params.get('cat') ?? '';

  // Reflect the current filter in the radio inputs.
  for (const input of document.querySelectorAll<HTMLInputElement>(
    '.filter-set input[type="radio"]',
  )) {
    if (input.value === activeCat) {
      input.checked = true;
    }
  }

  // Filter cards in place and update the count.
  const list = document.querySelector<HTMLElement>('[data-entry-list]');
  const countEl = document.querySelector<HTMLElement>('[data-count]');
  const cards = document.querySelectorAll<HTMLElement>('.entry-card');

  function applyFilter(cat: string) {
    let visible = 0;
    for (const card of cards) {
      const match = cat === '' || card.dataset.category === cat;
      card.hidden = !match;
      if (match) visible++;
    }
    if (countEl) {
      countEl.textContent = `${visible} ${visible === 1 ? 'entry' : 'entries'}`;
    }
    // Sort: reachable first, then unreachable.
    if (list) {
      const items = [...list.querySelectorAll<HTMLElement>('.entry-card')];
      const reachable = items.filter((c) => !c.hidden && c.dataset.unreachable !== 'true');
      const unreachable = items.filter((c) => !c.hidden && c.dataset.unreachable === 'true');
      for (const item of [...reachable, ...unreachable]) list.appendChild(item);
    }
  }

  applyFilter(activeCat);

  for (const input of document.querySelectorAll<HTMLInputElement>(
    '.filter-set input[type="radio"]',
  )) {
    input.addEventListener('change', () => {
      const url = new URL(window.location.href);
      if (input.value) {
        url.searchParams.set('cat', input.value);
      } else {
        url.searchParams.delete('cat');
      }
      window.history.pushState({}, '', url);
      applyFilter(input.value);
    });
  }

  // ── Freshness overlay ─────────────────────────────────────────────────────────────────
  //
  // Network link to external URLs, so fresh cards carry the real link directly — no
  // view page needed. Everything here fails silently; see src/lib/fresh.ts.

  void (async () => {
    const since = document.querySelector<HTMLElement>('[data-corpus]')?.dataset.exportedAt;
    const entryList = document.querySelector<HTMLElement>('[data-entry-list]');
    const template = document.querySelector<HTMLTemplateElement>('[data-fresh-entry]');
    const emptyEl = document.querySelector<HTMLElement>('.corpus__empty');

    if (!since || !template) return;

    const { networkSince } = await import('../../lib/fresh');
    const { categoryLabel } = await import('../../lib/network');

    const fresh = await networkSince(since);
    if (fresh.length === 0) return;

    // If the page was empty (no exported entries), hide the empty message and
    // create a list to receive the fresh cards.
    let targetList = entryList;
    if (!targetList) {
      // Where the empty message is, which is where the list would have been. Anchored on
      // that element rather than on the submit button it used to sit above: the button has
      // moved to the top of the page, and the last child of [data-corpus] is now the
      // <template> these cards are cloned from — appending past it would put the listing
      // below the fold of the page for no reason. No message means no insertion point, and
      // nothing to do.
      if (!emptyEl) return;

      targetList = document.createElement('ul');
      targetList.className = 'entry-list';
      targetList.setAttribute('role', 'list');
      targetList.dataset.entryList = '';

      emptyEl.insertAdjacentElement('afterend', targetList);
      emptyEl.hidden = true;
    }

    for (const entry of fresh) {
      const node = (template.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;

      node.dataset.category = entry.category;

      const titleEl = node.querySelector<HTMLAnchorElement>('[data-title]');
      if (titleEl) {
        titleEl.textContent = entry.title;
        titleEl.href = entry.url;
      }

      const urlEl = node.querySelector<HTMLElement>('[data-url]');
      if (urlEl) urlEl.textContent = entry.urlNormalised;

      const descEl = node.querySelector<HTMLElement>('[data-description]');
      if (descEl) descEl.textContent = entry.description;

      const relEl = node.querySelector<HTMLElement>('[data-relevance]');
      if (relEl) relEl.textContent = entry.relevance;

      const catEl = node.querySelector<HTMLElement>('[data-category-label]');
      if (catEl) catEl.textContent = categoryLabel(entry.category as Parameters<typeof categoryLabel>[0]);

      targetList.prepend(node);
    }

    // Update the visible count.
    const countEl = document.querySelector<HTMLElement>('[data-count]');
    if (countEl) {
      const total = targetList.querySelectorAll('.entry-card:not([hidden])').length;
      countEl.textContent = `${total} ${total === 1 ? 'entry' : 'entries'}`;
    }
  })();
</script>

<style>
  .network-corpus {
    padding-block: var(--space-2xl);
  }

  .corpus__empty {
    color: var(--ink-muted);
    font-size: var(--size-3);
  }

  .entry-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry-card {
    padding: var(--space-md);
    border: var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--surface);
  }

  .entry-card[data-unreachable='true'] {
    border-color: var(--outcome-failed);
    opacity: 0.8;
  }

  .entry-card__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    margin-block-end: var(--space-3xs);
  }

  .entry-card__title {
    font-family: var(--font-serif);
    font-size: var(--size-4);
    font-weight: var(--weight-semibold);
    color: var(--accent-strong);
  }

  .entry-card__unreachable {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    letter-spacing: var(--tracking-wide);
    color: var(--outcome-failed);
    padding: var(--space-3xs) var(--space-2xs);
    border: 1px solid var(--outcome-failed);
    border-radius: var(--radius-sm);
  }

  .entry-card__redirected {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    letter-spacing: var(--tracking-wide);
    color: var(--ink-muted);
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--border);
    border-radius: var(--radius-sm);
  }

  .entry-card__url {
    font-size: var(--size-1);
    color: var(--ink-muted);
    margin-block-end: var(--space-xs);
    word-break: break-all;
  }

  .entry-card__description {
    font-size: var(--size-2);
    line-height: var(--leading-relaxed);
    margin-block-end: var(--space-xs);
  }

  .entry-card__relevance {
    font-size: var(--size-2);
    line-height: var(--leading-relaxed);
    color: var(--ink-muted);
    margin-block-end: var(--space-sm);
  }

  .entry-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    font-size: var(--size-1);
    color: var(--ink-muted);
  }

  .entry-card__category {
    padding: var(--space-3xs) var(--space-2xs);
    border: var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--ground);
  }

  .entry-card__erased {
    font-style: italic;
  }

  .filter-apply {
    margin-block-start: var(--space-sm);
    font-size: var(--size-2);
  }

  @media (max-width: 48rem) {
    .listing {
      grid-template-columns: 1fr;
    }
  }
</style>
