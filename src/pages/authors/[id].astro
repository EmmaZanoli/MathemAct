---
/**
 * Everything one contributor has published.
 *
 * Deliberately thin. This is not a profile page with a follower count and an activity
 * graph — it is the answer to "what else has this person written", which is the question a
 * reader asks after an account they found useful. Anything more would turn a corpus into a
 * network, and the corpus is the point.
 *
 * Practices, then propositions, then resources: authored accounts, then claims they have put
 * to the community, then things they have pointed at. Only practices get cards. A proposition
 * is one sentence and a resource is a link, so both are listed — on this page the question is
 * what someone has contributed, not the full case for each item, which is what
 * /propositions/ and /resources/ are for. The lists are thin for the same reason the page is.
 *
 * A person can appear here with no practices at all: a proposition author and a resource
 * submitter are both contributors. `listContributors()` is the union, and it is the
 * definition of which pages exist.
 *
 * The badge block says exactly what was verified and no more: an address at an
 * institution's domain was confirmed to work, on a date. Not employment, not position, not
 * seniority. A pseudonym is marked as one, at every tier, because a pseudonymous
 * institutional badge is a normal and intended combination here.
 */
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import PracticeCard from '../../components/PracticeCard.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { listContributors } from '../../lib/authors';
import { longDate } from '../../lib/format';
import { path } from '../../lib/paths';
import { practicesByAuthor } from '../../lib/practices';
import { areaLabel } from '../../lib/practice-schema';
import { propositionsByAuthor } from '../../lib/propositions';
import { categoryLabel, resourcesBySubmitter } from '../../lib/resources';

export async function getStaticPaths() {
  const contributors = await listContributors();

  return Promise.all(
    contributors.map(async (author) => ({
      params: { id: author.id },
      props: {
        author,
        practices: await practicesByAuthor(author.id),
        propositions: await propositionsByAuthor(author.id),
        resources: resourcesBySubmitter(author.id),
      },
    })),
  );
}

const { author, practices, propositions, resources } = Astro.props;

const outcomes = {
  worked: practices.filter((practice) => practice.outcome === 'worked').length,
  partial: practices.filter((practice) => practice.outcome === 'partial').length,
  failed: practices.filter((practice) => practice.outcome === 'failed').length,
};
---

<Base
  title={author.displayName}
  description={`Practices and resources contributed to MathemAct by ${author.displayName}.`}
>
  <div class="shell corpus">
    <p class="breadcrumb">
      <a href={path('/practices/')}>← All practices</a>
    </p>

    <header class="corpus__header">
      <h1>{author.displayName}</h1>

      {
        author.isPseudonym && (
          <p class="corpus__lead">
            A pseudonym. Pseudonyms are allowed at every verification tier here, including
            alongside an institutional badge — please do not try to work out who this is.
          </p>
        )
      }

      <div class="author__badges">
        <Badges institution={author.institution} />
      </div>

      {/* One line per kind of contribution, stacked, rather than one line with rules between
          them. Three counts and the outcome breakdown do not fit on a line at this size, and
          a wrapped flex item keeps the border that was standing in for a separator — so the
          second line began with a rule attached to nothing. Somebody with only practices,
          which is nearly everybody, sees exactly one line either way. */}
      <ul class="author__summary" role="list">
        <li>
          <span class="meta">
            {practices.length} published {practices.length === 1 ? 'practice' : 'practices'}
          </span>
          {
            practices.length > 0 && (
              <span class="author__breakdown">
                {' '}— {outcomes.worked} worked, {outcomes.partial} partly worked,{' '}
                {outcomes.failed} did not
              </span>
            )
          }
        </li>
        {
          propositions.length > 0 && (
            <li>
              <span class="meta">
                {propositions.length}{' '}
                {propositions.length === 1 ? 'proposition' : 'propositions'}
              </span>
            </li>
          )
        }
        {
          resources.length > 0 && (
            <li>
              <span class="meta">
                {resources.length} {resources.length === 1 ? 'resource' : 'resources'}{' '}
                submitted
              </span>
            </li>
          )
        }
      </ul>
    </header>

    {
      practices.length === 0 && propositions.length === 0 && resources.length === 0 && (
        <div class="empty">
          <p class="empty__heading">Nothing published yet.</p>
          <p>
            This account exists and has posted nothing that has cleared moderation. Pending
            submissions are visible only to their author.
          </p>
        </div>
      )
    }

    {
      practices.length > 0 && (
        <section>
          <h2 class="author__section">Practices</h2>
          {practices.map((practice) => (
            <PracticeCard practice={practice} showAuthor={false} />
          ))}
        </section>
      )
    }

    {
      propositions.length > 0 && (
        <section>
          <h2 class="author__section">Propositions</h2>

          {/* The same list the propositions index uses, classes and all — those live in
              corpus.css rather than in that page's scoped block, which is what makes one
              claim look the same wherever it is read. */}
          <ul class="proposition-list" role="list">
            {propositions.map((proposition) => (
              <li class="proposition-item">
                <a
                  class="proposition-item__link"
                  href={path(`/propositions/${proposition.id}/`)}
                >
                  {proposition.statement}
                </a>
                <p class="card__facts proposition-item__facts">
                  <span>{areaLabel(proposition.area)}</span>
                  <span class="meta">
                    {proposition.status === 'active'
                      ? `Active since ${longDate(proposition.activatedAt)}`
                      : `Proposed ${longDate(proposition.createdAt)}`}
                  </span>
                </p>
              </li>
            ))}
          </ul>

          <p class="author__more">
            <a href={path('/propositions/')}>All propositions</a>
          </p>
        </section>
      )
    }

    {
      resources.length > 0 && (
        <section>
          <h2 class="author__section">Resources submitted</h2>

          <ul class="author__resources" role="list">
            {resources.map((resource) => (
              <li class="author__resource">
                <p class="author__resource-title">
                  <a href={resource.url} rel="noopener noreferrer" target="_blank">
                    {resource.title}
                  </a>
                  {resource.linkStatus === 'unreachable' && (
                    <span
                      class="author__broken"
                      title="This link was unreachable at the last monthly check"
                    >
                      Link may be broken
                    </span>
                  )}
                </p>

                <ul class="card__facts" role="list">
                  <li>
                    <span class="meta">{resource.urlNormalised}</span>
                  </li>
                  <li>{categoryLabel(resource.category)}</li>
                </ul>
              </li>
            ))}
          </ul>

          <p class="author__more">
            <a href={path('/resources/')}>All resources</a>
          </p>
        </section>
      )
    }
  </div>
</Base>

<style>
  .breadcrumb {
    margin-block-end: var(--space-md);
    font-size: var(--size-2);
  }

  .author__badges {
    margin-block-start: var(--space-md);
  }

  .author__summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    margin-block: var(--space-md) 0;
    padding: 0;
    list-style: none;
    color: var(--ink-muted);
    font-size: var(--size-2);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    letter-spacing: var(--tracking-wide);
  }

  /* A section label rather than a title. There are two kinds of contribution on this page
     now, so both are named — an unlabelled first list and a labelled second one would read
     as though the practices were the page and the resources an afterthought. Set as the
     labels elsewhere on this site are: mono, tracked out, quiet. */
  .author__section {
    margin-block: var(--space-xl) 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    font-weight: var(--weight-normal);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .author__resources {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author__resource {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-block: var(--space-sm);
    border-block-start: var(--border);
  }

  .author__resource-title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: baseline;
    margin: 0;
  }

  /* Stated in words, not in colour. A resource whose link failed the monthly check is still
     part of the corpus and still worth seeing — it is a fact about the link, not a verdict
     on the contribution, so it gets no outcome colour and no tombstone. */
  .author__broken {
    font-size: var(--size-1);
    font-style: italic;
    color: var(--ink-muted);
  }

  .author__more {
    margin-block-start: var(--space-md);
    font-size: var(--size-2);
  }
</style>
