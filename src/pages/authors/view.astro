---
/**
 * Client-rendered author page for contributors who do not yet have a static one.
 *
 * `/authors/<id>/` is generated by getStaticPaths from the committed corpus, which means an
 * author page exists only for someone who already had a published practice at the last
 * export. Somebody's *first* practice therefore arrives with no author page behind it: the
 * practice is live, its name is on it, and the link under that name is a 404 until the
 * nightly build runs. That window is exactly when a new contributor is most likely to click
 * it, having just posted and sent the link to a colleague.
 *
 * Pattern and rationale: same as /practices/view/, /propositions/view/ and /moderate/. Anon
 * fetches against PostgREST get what the static page bakes in — the profile, the published
 * practices, the staleness aggregate that decides each tombstone, and the resources this
 * person has submitted. `/authors/<id>/` stays the canonical URL once a build has run;
 * nothing links here except pages that are themselves runtime-rendered.
 *
 * **Everything this page links to is a runtime-rendered view page**, because this page
 * exists precisely when the export cannot be trusted to contain the rows. A card title
 * pointing at /practices/<id>/ would reintroduce the 404 this page is here to remove — one
 * level down, and for the same reason.
 *
 * What is omitted relative to the static page: Pagefind indexing, and the tool-use date
 * under each tombstone. Both come back at the next build. The tombstone itself is not
 * omitted — an author page is where a reader judges a body of work, and rendering every
 * square as unverified would misreport it.
 */
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import Tombstone from '../../components/Tombstone.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { path } from '../../lib/paths';
---

<Base title="Contributor" description="Practices contributed to MathemAct.">
  <div class="shell corpus">
    <p class="breadcrumb"><a href={path('/practices/')}>← All practices</a></p>

    <div data-loading>
      <p class="field__hint">Loading…</p>
    </div>

    <div data-error hidden>
      <p>This contributor could not be found, or the account has since been erased.</p>
      <p><a href={path('/practices/')}>Back to all practices</a></p>
    </div>

    <div data-content hidden>
      <header class="corpus__header">
        <h1 data-name></h1>

        <p class="corpus__lead" data-pseudonym hidden>
          A pseudonym. Pseudonyms are allowed at every verification tier here, including
          alongside an institutional badge — please do not try to work out who this is.
        </p>

        <div class="author__badges">
          <Badges pending />
        </div>

        <ul class="card__facts author__summary" role="list">
          <li>
            <span class="meta" data-count></span>
            <span class="author__breakdown" data-breakdown hidden></span>
          </li>
          <li data-resource-count-item hidden>
            <span class="meta" data-resource-count></span>
          </li>
        </ul>
      </header>

      <div class="empty" data-none hidden>
        <p class="empty__heading">Nothing published yet.</p>
        <p>
          This account exists and has posted nothing that has cleared moderation. Pending
          submissions are visible only to their author.
        </p>
      </div>

      <section data-practices hidden>
        <h2 class="author__section">Practices</h2>
        <div data-listing></div>
      </section>

      <section data-resources hidden>
        <h2 class="author__section">Resources submitted</h2>
        <ul class="author__resources" role="list" data-resource-list></ul>
        <p class="author__more"><a href={path('/resources/')}>All resources</a></p>
      </section>
    </div>

    {/* Cloned per practice. The Tombstone is rendered here rather than assembled in script
        for the reason the listing does the same: its scoped styles belong to the file that
        authored the element, so a hand-built square would come out unstyled. Its two
        per-card values are mutated below. */}
    <template data-card>
      <article class="card">
        <div>
          <Tombstone status="unverified" />
        </div>

        <h3 class="card__title"><a data-title></a></h3>
        <p class="card__aim" data-aim></p>

        <ul class="card__facts" role="list">
          <li data-area></li>
          <li data-task></li>
        </ul>

        <ul class="card__tools" role="list" data-tools></ul>
      </article>
    </template>

    {/* One submitted resource. Same two lines as the static page: what it is, then where it
        goes and what kind of thing it is. */}
    <template data-resource-card>
      <li class="author__resource">
        <p class="author__resource-title">
          <a data-title rel="noopener noreferrer" target="_blank"></a>
          <span
            class="author__broken"
            title="This link was unreachable at the last monthly check"
            data-broken
            hidden>Link may be broken</span
          >
        </p>

        <ul class="card__facts" role="list">
          <li><span class="meta" data-url></span></li>
          <li data-category></li>
        </ul>
      </li>
    </template>
  </div>
</Base>

<style>
  .breadcrumb {
    margin-block-end: var(--space-md);
    font-size: var(--size-2);
  }

  .author__badges {
    margin-block-start: var(--space-md);
  }

  /* Layout comes from .card__facts in corpus.css. Kept identical to /authors/<id>/, which
     this page stands in for — see the note at the top of the file. */
  .author__summary {
    margin-block-start: var(--space-md);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--size-1);
    letter-spacing: var(--tracking-wide);
  }

  .author__section {
    margin-block: var(--space-xl) 0;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--size-0);
    font-weight: var(--weight-normal);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .author__resources {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .author__resource {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-block: var(--space-sm);
    border-block-start: var(--border);
  }

  .author__resource-title {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    align-items: baseline;
    margin: 0;
  }

  .author__broken {
    font-size: var(--size-1);
    font-style: italic;
    color: var(--ink-muted);
  }

  .author__more {
    margin-block-start: var(--space-md);
    font-size: var(--size-2);
  }
</style>

<script>
  import { verificationMonth } from '../../lib/format';
  import { areaLabel, taskTypeLabel } from '../../lib/practice-schema';
  import { path } from '../../lib/paths';
  // categoryLabel only. Importing listResources here would pull data/resources.json into
  // this page's bundle, and the whole point of this page is that it reads live.
  import { categoryLabel } from '../../lib/resources';
  import type { ResourceCategory, ResourceLinkStatus } from '../../lib/resources';
  import { OUTCOME, TOMBSTONE_STATUS, tombstoneName } from '../../lib/status';
  import type { Outcome, TombstoneStatus } from '../../lib/status';

  const id = new URLSearchParams(window.location.search).get('id');

  const loadingEl = document.querySelector<HTMLElement>('[data-loading]')!;
  const errorEl = document.querySelector<HTMLElement>('[data-error]')!;
  const contentEl = document.querySelector<HTMLElement>('[data-content]')!;

  if (!id) {
    loadingEl.hidden = true;
    errorEl.hidden = false;
  } else {
    await init(id);
  }

  async function init(authorId: string): Promise<void> {
    const author = await fetchAuthor(authorId);

    if (!author) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      return;
    }

    document.title = `${author.displayName} | MathemAct`;
    setText('[data-name]', author.displayName);

    if (author.isPseudonym) {
      document.querySelector<HTMLElement>('[data-pseudonym]')!.hidden = false;
    }

    // The badge block, filled exactly as the account page fills it: Registered is already
    // in the markup, and the institutional line is revealed only when there is one. What it
    // claims is settled in Badges.astro; this only supplies the detail string.
    const badges = document.querySelector<HTMLElement>('[data-badges]')!;
    if (author.institution) {
      const { name, country, verifiedAt } = author.institution;
      setText(
        '[data-badge-detail]',
        `${name}, ${country} (${verificationMonth(verifiedAt)})`,
      );
      document.querySelector<HTMLElement>('[data-badge="institutional"]')!.hidden = false;
    }
    badges.hidden = false;

    // Both corpora at once. A resource submitter is a contributor whether or not they have
    // ever posted a practice, which is why /authors/<id>/ exists for them too.
    const [practices, resources] = await Promise.all([
      fetchPractices(authorId),
      fetchResources(authorId),
    ]);

    setText(
      '[data-count]',
      `${practices.length} published ${practices.length === 1 ? 'practice' : 'practices'}`,
    );

    if (resources.length > 0) {
      setText(
        '[data-resource-count]',
        `${resources.length} ${resources.length === 1 ? 'resource' : 'resources'} submitted`,
      );
      document.querySelector<HTMLElement>('[data-resource-count-item]')!.hidden = false;
      renderResources(resources);
    }

    if (practices.length === 0) {
      if (resources.length === 0) {
        document.querySelector<HTMLElement>('[data-none]')!.hidden = false;
      }
      loadingEl.hidden = true;
      contentEl.hidden = false;
      return;
    }

    const worked = practices.filter((practice) => practice.outcome === 'worked').length;
    const partial = practices.filter((practice) => practice.outcome === 'partial').length;
    const failed = practices.filter((practice) => practice.outcome === 'failed').length;

    const breakdown = document.querySelector<HTMLElement>('[data-breakdown]')!;
    breakdown.textContent = `— ${worked} worked, ${partial} partly worked, ${failed} did not`;
    breakdown.hidden = false;

    // One request for every tombstone on the page, keyed by practice. A practice nobody has
    // confirmed has no row in the aggregate for the same reason it has an open square, so a
    // missing key means `unverified` rather than an error.
    const staleness = await fetchStaleness(practices.map((practice) => practice.id));

    const template = document.querySelector<HTMLTemplateElement>('[data-card]')!;
    const listing = document.querySelector<HTMLElement>('[data-listing]')!;
    for (const practice of practices) {
      listing.append(card(template, practice, staleness.get(practice.id) ?? 'unverified'));
    }
    document.querySelector<HTMLElement>('[data-practices]')!.hidden = false;

    loadingEl.hidden = true;
    contentEl.hidden = false;
  }

  function renderResources(resources: FetchedResource[]): void {
    const template = document.querySelector<HTMLTemplateElement>('[data-resource-card]')!;
    const list = document.querySelector<HTMLElement>('[data-resource-list]')!;

    for (const resource of resources) {
      const node = (template.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;

      const title = node.querySelector<HTMLAnchorElement>('[data-title]')!;
      title.textContent = resource.title;
      title.href = resource.url;

      if (resource.linkStatus === 'unreachable') {
        node.querySelector<HTMLElement>('[data-broken]')!.hidden = false;
      }

      put(node, '[data-url]', resource.urlNormalised);
      put(node, '[data-category]', categoryLabel(resource.category));

      list.append(node);
    }

    document.querySelector<HTMLElement>('[data-resources]')!.hidden = false;
  }

  function card(
    template: HTMLTemplateElement,
    practice: FetchedPractice,
    status: TombstoneStatus,
  ): HTMLElement {
    const node = (template.content.cloneNode(true) as DocumentFragment)
      .firstElementChild as HTMLElement;

    const tombstone = node.querySelector<HTMLElement>('.tombstone')!;
    tombstone.dataset.outcome = practice.outcome;
    tombstone.setAttribute('aria-label', tombstoneName(status, practice.outcome));
    // `data-filled` is an attribute the CSS tests for presence, not for value, so it has to
    // be removed rather than set to something falsy.
    if (TOMBSTONE_STATUS[status].filled) tombstone.dataset.filled = '';
    else delete tombstone.dataset.filled;
    const label = tombstone.querySelector<HTMLElement>('.tombstone__label');
    if (label) label.textContent = OUTCOME[practice.outcome].label;

    const title = node.querySelector<HTMLAnchorElement>('[data-title]')!;
    title.textContent = practice.title;
    title.href = path(`/practices/view/?id=${practice.id}`);

    put(node, '[data-aim]', practice.aim);
    put(node, '[data-area]', areaLabel(practice.area));
    put(node, '[data-task]', taskTypeLabel(practice.taskType));

    const tools = node.querySelector<HTMLElement>('[data-tools]')!;
    for (const tool of practice.tools) tools.append(chip(tool.name, tool.version));
    for (const tag of practice.tags) tools.append(chip(tag, null, true));

    return node;
  }

  function setText(selector: string, text: string): void {
    const el = document.querySelector<HTMLElement>(selector);
    if (el) el.textContent = text;
  }

  function put(root: HTMLElement, selector: string, text: string): void {
    const element = root.querySelector<HTMLElement>(selector);
    if (element) element.textContent = text;
  }

  /** A tool or tag chip. Built rather than cloned: `.tool-chip` is global in corpus.css. */
  function chip(name: string, version: string | null, isTag = false): HTMLElement {
    const item = document.createElement('li');
    item.className = isTag ? 'tool-chip tool-chip--tag' : 'tool-chip';

    const label = document.createElement('span');
    label.className = 'tool-chip__name';
    label.textContent = name;
    item.append(label);

    if (version) {
      const number = document.createElement('span');
      number.className = 'tool-chip__version';
      number.textContent = version;
      item.append(number);
    }

    return item;
  }

  // ── Data fetch ────────────────────────────────────────────────────────────────────────

  interface FetchedAuthor {
    readonly displayName: string;
    readonly isPseudonym: boolean;
    readonly institution: {
      readonly name: string;
      readonly country: string;
      readonly verifiedAt: string;
    } | null;
  }

  interface FetchedResource {
    readonly id: string;
    readonly title: string;
    readonly url: string;
    readonly urlNormalised: string;
    readonly category: ResourceCategory;
    readonly linkStatus: ResourceLinkStatus;
  }

  interface FetchedPractice {
    readonly id: string;
    readonly title: string;
    readonly aim: string;
    readonly area: string;
    readonly taskType: string;
    readonly outcome: Outcome;
    readonly tools: readonly { name: string; version: string }[];
    readonly tags: readonly string[];
  }

  /** One GET, or none. Every failure is a null result: an id that is not a UUID, a paused
   *  project, a row RLS does not expose. All of them mean the same thing to a reader. */
  async function ask<T>(query: string): Promise<T[]> {
    const base = import.meta.env.PUBLIC_SUPABASE_URL as string | undefined;
    const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string | undefined;
    if (!base || !key) return [];

    try {
      const response = await fetch(`${base}/rest/v1/${query}`, {
        headers: { apikey: key, Authorization: `Bearer ${key}` },
      });

      if (!response.ok) return [];
      const rows = await response.json();
      return Array.isArray(rows) ? rows : [];
    } catch {
      return [];
    }
  }

  async function fetchAuthor(id: string): Promise<FetchedAuthor | null> {
    // institution_source is deliberately absent: CLAUDE.md says it is never displayed, and
    // a column that is never displayed should not be in a query that feeds a page.
    const select =
      'display_name,is_pseudonym,institution_name,institution_country,institution_verified_at';

    const rows = await ask<RawProfile>(
      `profiles?select=${encodeURIComponent(select)}&id=eq.${encodeURIComponent(id)}&limit=1`,
    );

    const row = rows[0];
    if (!row) return null;

    return {
      displayName: row.display_name,
      isPseudonym: row.is_pseudonym,
      // All three or none. A name without a verification date would be the one claim the
      // badge exists not to make.
      institution:
        row.institution_name && row.institution_country && row.institution_verified_at
          ? {
              name: row.institution_name,
              country: row.institution_country,
              verifiedAt: row.institution_verified_at,
            }
          : null,
    };
  }

  /**
   * This author's published practices, newest first.
   *
   * The status and deleted_at filters restate what row level security already enforces for
   * the anonymous key, for the same reason src/lib/fresh.ts does: this is content rendered
   * as though it came from the corpus, and the day somebody widens a policy is the day it
   * would start showing pending submissions to everybody.
   */
  async function fetchPractices(id: string): Promise<FetchedPractice[]> {
    const select = [
      'id,title,aim,area,task_type,outcome',
      'practice_tools(tool_name,tool_version)',
      'practice_tags(tags(code))',
    ].join(',');

    const rows = await ask<RawPractice>(
      `practices?select=${encodeURIComponent(select)}` +
        `&author_id=eq.${encodeURIComponent(id)}` +
        '&status=eq.published&deleted_at=is.null&order=created_at.desc',
    );

    return rows.map((row) => ({
      id: row.id,
      title: row.title,
      aim: row.aim,
      area: row.area,
      taskType: row.task_type,
      outcome: row.outcome,
      tools: (row.practice_tools ?? []).map((tool) => ({
        name: tool.tool_name,
        version: tool.tool_version,
      })),
      tags: (row.practice_tags ?? []).flatMap((link) => (link.tags ? [link.tags.code] : [])),
    }));
  }

  /** This author's published resources, newest first. Same restated filters, same reason. */
  async function fetchResources(id: string): Promise<FetchedResource[]> {
    const rows = await ask<RawResource>(
      'resources?select=id,title,url,url_normalised,category,link_status' +
        `&submitter_id=eq.${encodeURIComponent(id)}` +
        '&status=eq.published&deleted_at=is.null&order=created_at.desc',
    );

    return rows.map((row) => ({
      id: row.id,
      title: row.title,
      url: row.url,
      urlNormalised: row.url_normalised,
      category: row.category,
      linkStatus: row.link_status,
    }));
  }

  /** The tombstone status per practice, straight from public.practice_staleness. Never
   *  recomputed here: the same answer has to appear in a listing, on a page, and in the
   *  export. */
  async function fetchStaleness(ids: string[]): Promise<Map<string, TombstoneStatus>> {
    if (ids.length === 0) return new Map();

    const rows = await ask<RawStaleness>(
      'practice_staleness?select=practice_id,tombstone_status' +
        `&practice_id=in.(${ids.map(encodeURIComponent).join(',')})`,
    );

    return new Map(rows.map((row) => [row.practice_id, row.tombstone_status]));
  }

  interface RawProfile {
    display_name: string;
    is_pseudonym: boolean;
    institution_name: string | null;
    institution_country: string | null;
    institution_verified_at: string | null;
  }

  interface RawPractice {
    id: string;
    title: string;
    aim: string;
    area: string;
    task_type: string;
    outcome: Outcome;
    practice_tools: { tool_name: string; tool_version: string }[];
    practice_tags: { tags: { code: string } | null }[];
  }

  interface RawStaleness {
    practice_id: string;
    tombstone_status: TombstoneStatus;
  }

  interface RawResource {
    id: string;
    title: string;
    url: string;
    url_normalised: string;
    category: ResourceCategory;
    link_status: ResourceLinkStatus;
  }
</script>
