---
/**
 * One debate, and what the community made of it.
 *
 * The rule that shapes the whole page: **the distribution is not shown until the reader has
 * answered.** Not hidden behind a click — absent from the page, fetched afterwards. Baking
 * it into the HTML and hiding it with CSS would make bandwagon protection a decoration that
 * view-source defeats.
 *
 * Worth being straight about what this is and is not. The aggregate endpoint is public by
 * design and anyone determined can query it directly; what this prevents is the ordinary
 * reader forming a view after seeing where everyone else landed, which is where the effect
 * comes from. CLAUDE.md's reason for the rule is worth repeating because it is not the
 * usual one: this community's minority position is frequently the correct one.
 */
import Base from '../../layouts/Base.astro';
import CommentThread from '../../components/CommentThread.astro';
import FormStatus from '../../components/FormStatus.astro';
import Histogram from '../../components/Histogram.astro';
import RatingScale from '../../components/RatingScale.astro';
import References from '../../components/References.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { referencesFrom, referencesTo } from '../../lib/citations';
import { threadFor } from '../../lib/comments';
import { longDate } from '../../lib/format';
import { path } from '../../lib/paths';
import { areaLabel } from '../../lib/report-schema';
import { getDebate, listDebates } from '../../lib/debates';

export async function getStaticPaths() {
  const debates = await listDebates();
  return debates.map((debate) => ({ params: { id: debate.id } }));
}

const { id } = Astro.params;
const debate = await getDebate(id!);

if (!debate) return Astro.redirect(path('/debates/'));

const [thread, incoming, outgoing] = await Promise.all([
  threadFor('debate', debate.id),
  referencesTo('debate', debate.id),
  referencesFrom('debate', debate.id),
]);
---

<Base title={debate.statement} description={debate.rationale ?? debate.statement}>
  <div class="shell corpus debate">
    <p class="breadcrumb"><a href={path('/debates/')}>← All debates</a></p>

    {/* The statement and the rationale are quotable; the rating control is not. */}
    <header data-quotable data-pagefind-body>
      {/* Pagefind filter metadata. */}
      <span data-pagefind-filter="type:debate" hidden></span>
      <p class="debate__label">
        <span class="meta">
          {debate.status === 'active' ? 'Active debate' : 'Proposed'}
        </span>
      </p>

      {/* The statement is the page. Set as a blockquote because it is a claim being
          reported rather than the site speaking. */}
      <blockquote class="debate__statement">
        <p>{debate.statement}</p>
      </blockquote>

      <ul class="card__facts" role="list">
        <li data-pagefind-filter="area">{areaLabel(debate.area)}</li>
        <li>
          {
            debate.author ? (
              <>
                Proposed by{' '}
                <a href={path(`/authors/${debate.author.id}/`)}>
                  {debate.author.displayName}
                </a>
                {debate.author.isPseudonym && ' (a pseudonym)'}
              </>
            ) : (
              <span class="card__erased">Proposer since erased</span>
            )
          }
        </li>
        <li>
          <span class="meta">
            {debate.activatedAt
              ? `Active since ${longDate(debate.activatedAt)}`
              : `Proposed ${longDate(debate.createdAt)}`}
          </span>
        </li>
      </ul>
    </header>

    {
      debate.rationale && (
        <section class="field-block" data-quotable data-pagefind-body>
          <span class="field-block__label">Why this was proposed</span>
          <p class="field-block__body">{debate.rationale}</p>
        </section>
      )
    }

    <section class="rate" data-rate data-debate-id={debate.id} data-pagefind-ignore>
      <h2>Where do you stand?</h2>

      {/* Signed out. An anonymous reader cannot rate, so they cannot see the distribution
          either — the rule is about who has formed a view before looking, not about who is
          logged in, and making an exception here would be the loophole. */}
      <div class="panel" data-rate-signedout hidden>
        <p>
          <a href={path('/account/sign-in/')}>Sign in</a> to answer this one. The distribution
          appears once you have — you are asked what you think before you are told what
          everybody else thinks.
        </p>
      </div>

      <div class="panel" data-rate-unconfirmed hidden>
        <p>
          Rating needs a confirmed email address.
          <a href={path('/account/confirm/')}>Get another confirmation link</a>.
        </p>
      </div>

      <form class="form" data-rate-form hidden novalidate>
        <RatingScale name="score" />

        <div class="actions">
          <button class="button button--primary" type="submit">Record my answer</button>
        </div>

        <FormStatus id="rate-status" />
      </form>

      {/* One sentence, and it says why rather than that. "You must rate to see results" is
          a rule; this is a reason, and a reader who disagrees with it can at least argue
          with the right thing. */}
      <p class="rate__withheld" data-rate-withheld hidden>
        The distribution is hidden until you have answered, so that what other people think
        does not decide what you think.
      </p>

      <div data-aggregate-wrap hidden>
        <h3>How people answered</h3>
        <Histogram />
      </div>
    </section>

    <References incoming={incoming} outgoing={outgoing} />

    <div data-pagefind-ignore>
      <CommentThread
        parentType="debate"
        parentId={debate.id}
        nodes={thread}
        title={debate.statement}
        href={path(`/debates/${debate.id}/`)}
      />
    </div>
  </div>
</Base>

<script>
  import { renderHistogram } from '../../lib/histogram';
  import { loadAggregate, loadMyRating, saveRating } from '../../lib/debates';
  import { loadProfile, mayPost } from '../../lib/profile';
  import { startSession, subscribeToSession } from '../../lib/session';
  import { hideStatus, query, setBusy, showStatus } from '../../lib/forms';

  const root = query<HTMLElement>('[data-rate]');
  const debateId = root.dataset.debateId!;

  const signedOut = query<HTMLElement>('[data-rate-signedout]', root);
  const unconfirmed = query<HTMLElement>('[data-rate-unconfirmed]', root);
  const form = query<HTMLFormElement>('[data-rate-form]', root);
  const withheld = query<HTMLElement>('[data-rate-withheld]', root);
  const wrap = query<HTMLElement>('[data-aggregate-wrap]', root);
  const histogram = query<HTMLElement>('[data-histogram]', root);
  const status = query<HTMLElement>('#rate-status', root);
  const submit = query<HTMLButtonElement>('button[type="submit"]', form);

  let userId: string | null = null;
  let iRated = false;
  let myScore: number | null = null;

  subscribeToSession((state) => {
    if (state.status === 'loading') return;

    if (state.status !== 'signed-in') {
      userId = null;
      signedOut.hidden = false;
      form.hidden = true;
      withheld.hidden = false;
      return;
    }

    if (userId === state.userId) return;
    userId = state.userId;
    void open(state.userId);
  });

  void startSession();

  async function open(id: string): Promise<void> {
    const profile = await loadProfile(id);

    if (profile.ok && !mayPost(profile.value)) {
      unconfirmed.hidden = false;
      withheld.hidden = false;
      return;
    }

    form.hidden = false;

    const mine = await loadMyRating(debateId, id);
    if (!mine.ok) {
      showStatus(status, 'error', mine.message);
      return;
    }

    iRated = mine.value.rated;
    myScore = mine.value.score;

    if (iRated) {
      // Reflect the existing answer, so that editing starts from what they said rather than
      // from nothing — which would read as never having answered.
      const value = myScore === null ? 'none' : String(myScore);
      const input = form.querySelector<HTMLInputElement>(`input[name="score"][value="${value}"]`);
      if (input) input.checked = true;

      submit.textContent = 'Update my answer';
      await reveal();
    } else {
      withheld.hidden = false;
    }
  }

  async function reveal(): Promise<void> {
    const aggregate = await loadAggregate(debateId);
    if (!aggregate.ok) {
      showStatus(status, 'error', aggregate.message);
      return;
    }

    withheld.hidden = true;
    wrap.hidden = false;
    renderHistogram(histogram, aggregate.value, myScore, iRated);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    hideStatus(status);

    if (!userId) return;

    const chosen = form.querySelector<HTMLInputElement>('input[name="score"]:checked')?.value;
    if (chosen === undefined) {
      showStatus(
        status,
        'error',
        'Choose a point on the scale, or say that you have no opinion — that is a real answer and it is recorded as one.',
      );
      return;
    }

    // 'none' is the "no opinion / outside my expertise" answer and is stored as a null
    // score on a real row. It is not the absence of a rating.
    const score = chosen === 'none' ? null : Number(chosen);
    const editing = iRated;

    setBusy(submit, true, editing ? 'Updating…' : 'Recording…');
    const result = await saveRating(debateId, userId, score);
    setBusy(submit, false);

    if (!result.ok) {
      showStatus(status, 'error', result.message);
      return;
    }

    iRated = true;
    myScore = score;
    submit.textContent = 'Update my answer';

    await reveal();

    showStatus(
      status,
      'success',
      editing
        ? 'Rating updated.'
        : 'Answer recorded. Yours is never shown next to your name — only the distribution is public.',
    );
  });
</script>
