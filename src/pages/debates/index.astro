---
/**
 * Every debate, in one list.
 *
 * It used to be two — "active" and "proposed" — and the split was the page's argument: a
 * claim became part of the record only once five people had answered it or a moderator had
 * promoted it. That went with pre-moderation on 2026-08-18. A debate is part of the record
 * when it is written, and the honest reading of the old split is that it dressed a
 * moderation queue up as a statement about community uptake.
 *
 * Nothing is endorsed by being listed here, and the page still says so in the paragraph
 * below, which is where that claim always belonged.
 *
 * No aggregate anywhere on this page, not even a count of raters. A listing that showed
 * "42 raters, median 8" would tell a reader where the community landed before they had
 * opened the question, which is exactly what the debate page is careful not to do.
 */
import Base from '../../layouts/Base.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { longDate } from '../../lib/format';
import { exportedAt } from '../../lib/manifest';
import { path } from '../../lib/paths';
import { areaLabel } from '../../lib/report-schema';
import { listDebates, listDebateInteractionCounts } from '../../lib/debates';

const debates = await listDebates();
const debateInteractions = listDebateInteractionCounts();
---

<Base
  title="Debates"
  description="Claims about how AI tools should be used in mathematics, and where the community stands on each."
>
  <div class="shell corpus" data-corpus data-exported-at={exportedAt() ?? ''}>
    <header class="corpus__header">
      <h1>Debates</h1>
      <p class="corpus__lead">
        Single claims that can be agreed with. Answer one and you are shown how everybody
        else answered — in that order, deliberately.
      </p>
    </header>

    <div class="prose">
      <p>
        MathemAct takes no position on any of these. What it records is the shape of the
        disagreement: the full distribution and the median, never an average, because an
        average reports mild agreement for a community that has split cleanly into two camps.
      </p>
    </div>

    {/* Above the lists rather than below them, and outside the branch so it is here whether
        anything has been suggested or not. It was previously at the foot of the page, past
        two sections that will grow without limit — a control nobody scrolls to is a control
        that is not there. */}
    <p class="corpus__action">
      <a class="button button--primary" href={path('/debates/new/')}>Suggest a debate</a>
    </p>

    {debates.length > 0 && (
      <p class="results__sort">
        <label for="debate-sort">Sort by</label>
        <select id="debate-sort" data-sort>
          <option value="recent">Most recent</option>
          <option value="popularity">Most popular</option>
        </select>
      </p>
    )}

    {
      debates.length === 0 ? (
        <>
          {/* Where the overlay puts anything suggested since the export. The first
              debate ever written arrives here, on a page that would otherwise say
              there are none until the next nightly build. */}
          <ul class="debate-list" role="list" data-fresh-list hidden />

          <div class="empty" data-empty-state>
            <p class="empty__heading">No debates yet.</p>
            <p>
              The first ones will come from members who noticed an argument worth settling —
              or worth showing is not settled.
            </p>
            {/* The button that used to be here is now above this box, where it also stands
                for the populated page. */}
          </div>
        </>
      ) : (
        // The one list. It is also where the freshness overlay puts anything written since
        // the export, which is why it carries data-fresh-list as well.
        <ul class="debate-list" role="list" data-debate-list="all" data-fresh-list>
          {debates.map((debate) => (
            <li
              class="debate-item"
              data-debate
              data-created={debate.createdAt}
              data-interactions={debateInteractions.get(debate.id) ?? 0}
            >
              <a class="debate-item__link" href={path(`/debates/${debate.id}/`)}>
                {debate.statement}
              </a>
              <p class="card__facts debate-item__facts">
                <span>{areaLabel(debate.area)}</span>
                <span class="meta">Posted {longDate(debate.createdAt)}</span>
              </p>
            </li>
          ))}
        </ul>
      )
    }

    {/* One suggested since the export. Links to /debates/view/?id=<id>, the
        client-rendered viewer, because /debates/<id>/ is generated at build time
        from the export and does not exist yet for rows newer than the last build. */}
    <template data-fresh-debate>
      <li class="debate-item" data-fresh data-debate data-created="" data-interactions="0">
        <a class="debate-item__link" data-statement></a>
        <p class="card__facts debate-item__facts">
          <span data-area></span>
          <span class="meta" data-date></span>
        </p>
      </li>
    </template>
  </div>
</Base>

<script>
  /**
   * Sort and freshness overlay for the debates listing.
   *
   * Sort runs entirely in the browser over already-rendered `<li>` elements. It iterates
   * over every `[data-debate-list]` rather than the one there now, which is left as it was:
   * the page had two lists until the active/proposed split went, and a loop that assumes one
   * would have to be rewritten by whoever brings a second one back.
   *
   * Nothing about ratings is touched. The aggregate is never built into a page, so there is
   * no stale copy of one to refresh: a debate page fetches its distribution live, after
   * the reader has answered, and this listing shows no aggregate at all by design.
   */
  import { debatesSince } from '../../lib/fresh';
  import { longDate } from '../../lib/format';
  import { areaLabel } from '../../lib/report-schema';

  const sort = document.querySelector<HTMLSelectElement>('[data-sort]');

  function order(): void {
    if (!sort) return;
    const by = sort.value;

    for (const list of document.querySelectorAll<HTMLElement>('[data-debate-list]')) {
      const items = [...list.querySelectorAll<HTMLElement>('[data-debate]')];

      const sorted = items.sort((a, b) => {
        if (by === 'popularity') {
          const left = Number(a.dataset.interactions ?? 0);
          const right = Number(b.dataset.interactions ?? 0);
          if (left !== right) return right - left;
        }
        return (b.dataset.created ?? '').localeCompare(a.dataset.created ?? '');
      });

      for (const item of sorted) list.append(item);
    }
  }

  function writeUrl(): void {
    if (!sort) return;
    const params = new URLSearchParams(window.location.search);
    if (sort.value === 'recent') {
      params.delete('sort');
    } else {
      params.set('sort', sort.value);
    }
    const query = params.toString();
    window.history.replaceState(
      {},
      '',
      query ? `${window.location.pathname}?${query}` : window.location.pathname,
    );
  }

  function readUrl(): void {
    if (!sort) return;
    const wanted = new URLSearchParams(window.location.search).get('sort');
    if (wanted === 'popularity' || wanted === 'recent') sort.value = wanted;
  }

  if (sort) {
    sort.addEventListener('change', () => {
      order();
      writeUrl();
    });
    window.addEventListener('popstate', () => {
      readUrl();
      order();
    });
    readUrl();
    order();
  }

  // ── Freshness overlay ─────────────────────────────────────────────────────────────────

  const since = document.querySelector<HTMLElement>('[data-corpus]')?.dataset.exportedAt;
  const list = document.querySelector<HTMLElement>('[data-fresh-list]');
  const template = document.querySelector<HTMLTemplateElement>('[data-fresh-debate]');

  if (since && list && template) {
    void (async () => {
      const fresh = await debatesSince(since);
      if (fresh.length === 0) return;

      for (const debate of fresh.reverse()) {
        const node = (template.content.cloneNode(true) as DocumentFragment)
          .firstElementChild as HTMLElement;

        const statement = node.querySelector<HTMLAnchorElement>('[data-statement]');
        const area = node.querySelector<HTMLElement>('[data-area]');
        if (statement) {
          statement.textContent = debate.statement;
          statement.href = `view/?id=${debate.id}`;
        }
        if (area) area.textContent = areaLabel(debate.area);
        const dateEl = node.querySelector<HTMLElement>('[data-date]');
        if (dateEl) dateEl.textContent = `Proposed ${longDate(debate.createdAt)}`;
        node.dataset.created = debate.createdAt;

        list.prepend(node);
      }

      list.hidden = false;
      // Whichever of these the page happens to be showing: "nothing waiting" under a
      // populated Proposed section, or the whole empty state.
      for (const selector of ['[data-none]', '[data-empty-state]']) {
        const element = document.querySelector<HTMLElement>(selector);
        if (element) element.hidden = true;
      }

      // Re-sort to place fresh items in the right position.
      order();
    })();
  }
</script>
