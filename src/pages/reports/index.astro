---
/**
 * The corpus, filtered.
 *
 * Every report is rendered into this page at build time and the filters hide and reorder
 * what is already there. That is not a shortcut around pagination — it is what makes the
 * filters linkable: the URL is the state, so a filtered view can be pasted into an email or
 * cited in a paper and the person who opens it sees what the sender saw. A server-rendered
 * filter would need a server, and there is not one.
 *
 * When the corpus outgrows one page — several thousand reports, on the order of a few
 * megabytes of HTML — this becomes a build-time split by area with the same URL contract.
 * Not before: a filter that needs a round trip is a filter people stop using.
 */
import Base from '../../layouts/Base.astro';
import ReportCard from '../../components/ReportCard.astro';
import Tombstone from '../../components/Tombstone.astro';
import '../../styles/corpus.css';
import '../../styles/forms.css';
import { exportedAt } from '../../lib/manifest';
import { path } from '../../lib/paths';
import { AREAS, OUTCOME_CHOICES, TASK_TYPES } from '../../lib/report-schema';
import { listReports, listToolNames, listUsedTags, listAllTags, listInteractionCounts } from '../../lib/reports';

const reports = await listReports();
const tools = await listToolNames();
const tags = await listUsedTags();
const allTags = await listAllTags();
const tagVocab = Object.fromEntries(allTags.map((t) => [t.code, t.label]));
const extraInteractions = listInteractionCounts();

/** Only offer a filter that some report actually has. A vocabulary of ten task types over
 *  a corpus of four is nine dead ends and one result. */
const usedAreas = new Set(reports.map((report) => report.area));
const usedTaskTypes = new Set(reports.map((report) => report.taskType));
const usedOutcomes = new Set(reports.map((report) => report.outcome));

const groups = [
  {
    key: 'area',
    legend: 'Area',
    options: AREAS.filter((choice) => usedAreas.has(choice.value)).map((choice) => ({
      value: choice.value,
      label: choice.label,
    })),
  },
  {
    key: 'task',
    legend: 'Task type',
    options: TASK_TYPES.filter((choice) => usedTaskTypes.has(choice.value)).map((choice) => ({
      value: choice.value,
      label: choice.label,
    })),
  },
  {
    key: 'outcome',
    legend: 'Outcome',
    options: OUTCOME_CHOICES.filter((choice) => usedOutcomes.has(choice.value)).map((choice) => ({
      value: choice.value,
      label: choice.label,
    })),
  },
  {
    key: 'tag',
    legend: 'Subject area',
    options: tags.map((tag) => ({ value: tag.code, label: tag.label })),
  },
  {
    key: 'tool',
    legend: 'Tool',
    options: tools.map((tool) => ({ value: tool.toLowerCase(), label: tool })),
  },
].filter((group) => group.options.length > 0);
---

<Base
  title="Reports"
  description="First-hand accounts of how mathematicians have used AI tools, filterable by area, task, outcome, subject and tool."
>
  {/* The export timestamp travels to the browser on the element rather than through a
      `define:vars` script, which would have to be inline and could not import anything. The
      overlay asks the database for rows newer than this and prepends what it finds. */}
  <div class="shell corpus" data-corpus data-exported-at={exportedAt() ?? ''} data-tags-vocab={JSON.stringify(tagVocab)}>
    <header class="corpus__header">
      <h1>Reports</h1>
      <p class="corpus__lead">
        First-hand accounts of AI tool use in mathematical work. Filter them, sort them, and
        link the result — the filters are in the address bar, so a view of this corpus can be
        cited like anything else.
      </p>
    </header>

    {/* Outside the branch below, so it is here whatever state the corpus is in. It used to
        exist only inside the empty state, which meant the invitation to post vanished on
        the day the first report was published — and the empty state is itself hidden by
        the overlay as soon as one arrives, so there was a window where the page showed a
        report and no way to write another. */}
    <p class="corpus__action">
      <a class="button button--primary" href={path('/reports/new/')}>Post a report</a>
    </p>

    {
      reports.length === 0 ? (
        <>
          {/* The overlay's landing place when the export is empty. This is not a corner
              case: it is the state the site is in on the day the first report is posted,
              and without it that report would sit under "nothing has been published yet"
              until the next nightly build. */}
          <div class="listing listing--fresh" data-fresh-only hidden>
            <div class="results">
              <div data-results />
            </div>
          </div>

          <div class="empty" data-empty-state>
            <p class="empty__heading">Nothing has been published yet.</p>
            <p>
              The corpus is empty because it has not started. Every account in it will have
              been written by somebody who did the work and then took ten minutes to say
              what happened — including, and especially, when it did not go well.
            </p>
            {/* No second "post" button here. The one above this box does the same thing,
                and two filled reds on one screen makes neither of them the thing to do. */}
            <p class="actions">
              <a class="button" href={path('/about/')}>What this is for</a>
            </p>
          </div>
        </>
      ) : (
        <div class="listing">
          <form class="filters" data-filters>
            {groups.map((group) => (
              <fieldset class="filters__group" data-group={group.key}>
                <legend class="filters__legend">{group.legend}</legend>
                <div class="filters__options">
                  {group.options.map((option) => (
                    <label class="filters__option">
                      <input type="checkbox" name={group.key} value={option.value} />
                      <span>{option.label}</span>
                      <span class="filters__tally" data-tally={`${group.key}:${option.value}`} />
                    </label>
                  ))}
                </div>
              </fieldset>
            ))}
          </form>

          <div class="results">
            <div class="results__head">
              <p class="results__count" data-count aria-live="polite">
                {reports.length} reports
              </p>

              <p class="results__sort">
                <label for="sort">Sort by</label>
                <select id="sort" data-sort>
                  <option value="recent">Most recent</option>
                  <option value="activity">Confirmation activity</option>
                  <option value="popularity">Most popular</option>
                </select>
              </p>
            </div>

            {/* A cited link may name a tag that has since been retired or a tool nothing
                uses any more. Dropping those silently would show the reader more than the
                sender saw, without either of them finding out. */}
            <p class="results__dropped" data-dropped hidden></p>

            <ul class="chips" data-chips role="list" />

            <div data-results>
              {reports.map((report) => (
                <ReportCard
                  report={report}
                  interactionCount={
                    report.staleness.confirmationCount + (extraInteractions.get(report.id) ?? 0)
                  }
                />
              ))}
            </div>

            <div class="empty" data-no-results hidden>
              <p class="empty__heading">Nothing matches all of those filters.</p>
              <p data-suggestion />
              <p class="actions">
                <button class="button" type="button" data-clear>Clear all filters</button>
              </p>
            </div>
          </div>
        </div>
      )
    }

    {/* A card for something posted since the export.

        Deliberately not ReportCard: this one carries the marker, and its title is not a
        link. The page at /reports/<id>/ is generated at build time from the export, so a
        row newer than the export has no page yet — linking to one would be a 404 dressed up
        as a result. The marker says so rather than leaving a reader to find out by clicking.

        Written as markup rather than built in script so that the scoped styles below reach
        it, and so the Tombstone comes from the component that owns the glyph rather than
        from a second copy of its markup. Everything else here is a class from corpus.css,
        which is global, so a cloned node is styled like any other card. */}
    <template data-fresh-card>
      <article class="card" data-report data-fresh>
        <div>
          <Tombstone status="unverified" />
        </div>

        <p class="card__fresh">
          <span class="mono">Published <span data-date></span></span>
        </p>

        <h3 class="card__title"><a data-title></a></h3>
        <p class="card__aim" data-aim></p>

        <ul class="card__facts" role="list">
          <li data-area></li>
          <li data-task></li>
          <li data-author></li>
        </ul>

        <ul class="card__tools" role="list" data-tools></ul>
      </article>
    </template>
  </div>
</Base>

<script>
  /**
   * Filtering, sorting, and the URL — and, at the bottom, the freshness overlay.
   *
   * The address bar is the state. Every change writes to it with replaceState, and the page
   * reads it on load and on back-navigation, so a filtered view survives being copied,
   * bookmarked, or arrived at from a tag link on a report page.
   */
  import { reportsSince } from '../../lib/fresh';
  import type { FreshReport } from '../../lib/fresh';
  import { longDate } from '../../lib/format';
  import { path } from '../../lib/paths';
  import { areaLabel, taskTypeLabel, outcomeLabel } from '../../lib/report-schema';
  import { OUTCOME, tombstoneName } from '../../lib/status';

  const filters = document.querySelector<HTMLFormElement>('[data-filters]');

  if (filters) {
    const results = document.querySelector<HTMLElement>('[data-results]')!;
    const count = document.querySelector<HTMLElement>('[data-count]')!;
    const chips = document.querySelector<HTMLElement>('[data-chips]')!;
    const noResults = document.querySelector<HTMLElement>('[data-no-results]')!;
    const suggestion = document.querySelector<HTMLElement>('[data-suggestion]')!;
    const sort = document.querySelector<HTMLSelectElement>('[data-sort]')!;
    const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;

    const cards = [...results.querySelectorAll<HTMLElement>('[data-report]')];
    const DIMENSIONS = ['area', 'task', 'outcome', 'tag', 'tool'] as const;
    type Dimension = (typeof DIMENSIONS)[number];

    const LEGEND: Record<Dimension, string> = {
      area: 'Area',
      task: 'Task',
      outcome: 'Outcome',
      tag: 'Subject',
      tool: 'Tool',
    };

    /** The card attribute each dimension filters on, and whether it holds a list. */
    const FIELD: Record<Dimension, { attr: string; multi: boolean }> = {
      area: { attr: 'area', multi: false },
      task: { attr: 'taskType', multi: false },
      outcome: { attr: 'outcome', multi: false },
      tag: { attr: 'tags', multi: true },
      tool: { attr: 'tools', multi: true },
    };

    function selected(): Record<Dimension, string[]> {
      const chosen = {} as Record<Dimension, string[]>;

      for (const dimension of DIMENSIONS) {
        chosen[dimension] = [
          ...filters!.querySelectorAll<HTMLInputElement>(
            `input[name="${dimension}"]:checked`,
          ),
        ].map((input) => input.value);
      }

      return chosen;
    }

    /** Whether one card satisfies one dimension. An empty selection matches everything. */
    function matchesDimension(card: HTMLElement, dimension: Dimension, values: string[]): boolean {
      if (values.length === 0) return true;

      const field = FIELD[dimension];
      const raw = card.dataset[field.attr] ?? '';

      // Values within a dimension are OR'd: "research or teaching" is the useful question,
      // where "research and teaching" would always be empty. Dimensions are AND'd.
      return field.multi
        ? raw.split('|').some((entry) => values.includes(entry))
        : values.includes(raw);
    }

    function matches(card: HTMLElement, chosen: Record<Dimension, string[]>): boolean {
      return DIMENSIONS.every((dimension) => matchesDimension(card, dimension, chosen[dimension]));
    }

    function apply(pushUrl: boolean): void {
      const chosen = selected();
      const visible = cards.filter((card) => matches(card, chosen));

      for (const card of cards) card.hidden = !visible.includes(card);

      count.textContent =
        visible.length === cards.length
          ? `${cards.length} reports`
          : `${visible.length} of ${cards.length} reports`;

      order();
      paintChips(chosen);
      paintTallies(chosen);

      noResults.hidden = visible.length > 0;
      if (visible.length === 0) suggestion.textContent = suggest(chosen);

      if (pushUrl) writeUrl(chosen);
    }

    /**
     * Which single filter to loosen. For each active dimension, count what dropping it
     * alone would return, and name the one that unlocks the most — a dead end with a way
     * out of it is a different thing from a dead end.
     */
    function suggest(chosen: Record<Dimension, string[]>): string {
      let best: { dimension: Dimension; gain: number } | null = null;

      for (const dimension of DIMENSIONS) {
        if (chosen[dimension].length === 0) continue;

        const relaxed = { ...chosen, [dimension]: [] as string[] };
        const gain = cards.filter((card) => matches(card, relaxed)).length;

        if (gain > 0 && (!best || gain > best.gain)) best = { dimension, gain };
      }

      if (!best) {
        return 'Clearing the filters brings back the whole corpus, which is the only thing left to try.';
      }

      return (
        `Removing the ${LEGEND[best.dimension].toLowerCase()} filter would show ` +
        `${best.gain} ${best.gain === 1 ? 'report' : 'reports'}. It is the one narrowing this most.`
      );
    }

    function paintChips(chosen: Record<Dimension, string[]>): void {
      chips.replaceChildren();

      for (const dimension of DIMENSIONS) {
        for (const value of chosen[dimension]) {
          const input = filters!.querySelector<HTMLInputElement>(
            `input[name="${dimension}"][value="${CSS.escape(value)}"]`,
          );
          const label = input?.nextElementSibling?.textContent ?? value;

          const chip = document.createElement('li');
          chip.className = 'chip';

          const kind = document.createElement('span');
          kind.className = 'chip__kind';
          kind.textContent = LEGEND[dimension];

          const text = document.createElement('span');
          text.textContent = label;

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.textContent = '×';
          remove.setAttribute('aria-label', `Remove the ${LEGEND[dimension].toLowerCase()} filter ${label}`);
          remove.addEventListener('click', () => {
            if (input) input.checked = false;
            apply(true);
          });

          chip.append(kind, text, remove);
          chips.append(chip);
        }
      }
    }

    /** How many reports each option would leave, given everything else already chosen.
     *  An option that would return nothing is disabled rather than hidden, so the shape of
     *  the corpus stays visible. */
    function paintTallies(chosen: Record<Dimension, string[]>): void {
      for (const dimension of DIMENSIONS) {
        for (const input of filters!.querySelectorAll<HTMLInputElement>(
          `input[name="${dimension}"]`,
        )) {
          const probe = { ...chosen, [dimension]: [input.value] };
          const total = cards.filter((card) => matches(card, probe)).length;

          const tally = filters!.querySelector<HTMLElement>(
            `[data-tally="${dimension}:${CSS.escape(input.value)}"]`,
          );
          if (tally) tally.textContent = String(total);

          input.disabled = total === 0 && !input.checked;
        }
      }
    }

    function order(): void {
      const by = sort.value;

      const sorted = [...cards].sort((a, b) => {
        if (by === 'activity') {
          // Most recently confirmed first. A report nobody has checked sorts last
          // whatever its date, because this ordering is about attention rather than age.
          const left = a.dataset.confirmed || '';
          const right = b.dataset.confirmed || '';
          if (left !== right) return right.localeCompare(left);
        }

        if (by === 'popularity') {
          // Most interactions first (confirmations + comments + citations).
          // Reports with equal counts fall through to most recent.
          const left = Number(a.dataset.interactions ?? 0);
          const right = Number(b.dataset.interactions ?? 0);
          if (left !== right) return right - left;
        }

        return (b.dataset.created ?? '').localeCompare(a.dataset.created ?? '');
      });

      for (const card of sorted) results.append(card);
    }

    function writeUrl(chosen: Record<Dimension, string[]>): void {
      const params = new URLSearchParams();

      for (const dimension of DIMENSIONS) {
        if (chosen[dimension].length) params.set(dimension, chosen[dimension].join(','));
      }
      if (sort.value !== 'recent') params.set('sort', sort.value);

      const query = params.toString();
      window.history.replaceState(
        {},
        '',
        query ? `${window.location.pathname}?${query}` : window.location.pathname,
      );
    }

    function readUrl(): void {
      const params = new URLSearchParams(window.location.search);
      const dropped: string[] = [];

      for (const dimension of DIMENSIONS) {
        const values = (params.get(dimension) ?? '').split(',').filter(Boolean);
        const offered = new Set<string>();

        for (const input of filters!.querySelectorAll<HTMLInputElement>(
          `input[name="${dimension}"]`,
        )) {
          offered.add(input.value);
          input.checked = values.includes(input.value);
        }

        for (const value of values) {
          if (!offered.has(value)) dropped.push(`${LEGEND[dimension].toLowerCase()} ${value}`);
        }
      }

      // Said out loud rather than swallowed. Somebody following a link deserves to know
      // that they are seeing a wider view than the person who sent it.
      const notice = document.querySelector<HTMLElement>('[data-dropped]');
      if (notice) {
        notice.hidden = dropped.length === 0;
        notice.textContent = dropped.length
          ? `This link also filtered on ${dropped.join(', ')}, which nothing in the corpus ` +
            `currently has. Those filters are not applied, so you are seeing more than the ` +
            `person who sent it.`
          : '';
      }

      const wanted = params.get('sort');
      if (wanted === 'activity' || wanted === 'recent' || wanted === 'popularity') sort.value = wanted;
    }

    /** Return the filter fieldset for `dimension`, creating it if fresh cards introduce a
     *  value for a dimension that no static report uses (e.g. tags on a corpus with none). */
    function ensureGroup(dimension: Dimension): HTMLElement {
      const existing = filters.querySelector<HTMLElement>(`[data-group="${dimension}"]`);
      if (existing) return existing;

      const LEGEND_FULL: Record<Dimension, string> = {
        area: 'Area',
        task: 'Task type',
        outcome: 'Outcome',
        tag: 'Subject area',
        tool: 'Tool',
      };

      const fieldset = document.createElement('fieldset');
      fieldset.className = 'filters__group';
      fieldset.dataset.group = dimension;

      const legend = document.createElement('legend');
      legend.className = 'filters__legend';
      legend.textContent = LEGEND_FULL[dimension];

      const opts = document.createElement('div');
      opts.className = 'filters__options';

      fieldset.append(legend, opts);
      filters.append(fieldset);
      return fieldset;
    }

    /** Add a single filter option if nothing with that dimension+value already exists. */
    function injectOption(
      dimension: Dimension,
      value: string,
      labelOf: (v: string) => string,
    ): void {
      if (!value) return;
      if (filters.querySelector(`input[name="${dimension}"][value="${CSS.escape(value)}"]`)) return;

      const group = ensureGroup(dimension);
      const optionsContainer = group.querySelector<HTMLElement>('.filters__options')!;

      const label = document.createElement('label');
      label.className = 'filters__option';

      const input = document.createElement('input');
      input.type = 'checkbox';
      input.name = dimension;
      input.value = value;

      const text = document.createElement('span');
      text.textContent = labelOf(value);

      const tally = document.createElement('span');
      tally.className = 'filters__tally';
      tally.dataset.tally = `${dimension}:${value}`;

      label.append(input, text, tally);
      optionsContainer.append(label);
    }

    /** Inject filter options for any value a fresh card carries that has no checkbox yet.
     *  Must run before apply() so paintTallies() sees the new inputs. */
    function injectMissingOptions(freshCards: HTMLElement[]): void {
      const tagVocab: Record<string, string> = JSON.parse(
        document.querySelector<HTMLElement>('[data-corpus]')?.dataset.tagsVocab ?? '{}',
      );

      for (const card of freshCards) {
        injectOption('area', card.dataset.area ?? '', areaLabel);
        injectOption('task', card.dataset.taskType ?? '', taskTypeLabel);
        injectOption('outcome', card.dataset.outcome ?? '', outcomeLabel);

        for (const code of (card.dataset.tags ?? '').split('|').filter(Boolean)) {
          injectOption('tag', code, (c) => tagVocab[c] ?? c);
        }

        const toolKeys = (card.dataset.tools ?? '').split('|').filter(Boolean);
        const toolNames = (card.dataset.toolsNames ?? '').split('|');
        toolKeys.forEach((key, i) => injectOption('tool', key, () => toolNames[i] ?? key));
      }
    }

    filters.addEventListener('change', () => apply(true));
    sort.addEventListener('change', () => apply(true));
    clear.addEventListener('click', () => {
      filters!.reset();
      apply(true);
    });

    // Back and forward should move between filtered views, not out of the page.
    window.addEventListener('popstate', () => {
      readUrl();
      apply(false);
    });

    readUrl();
    apply(false);

    // Anything posted since the export joins the cards the filters already know about, so
    // it is filtered, counted and sorted like everything else rather than pinned above the
    // listing as a separate thing.
    void overlay((added) => {
      injectMissingOptions(added);
      cards.push(...added);
      apply(false);
    });
  }

  // ── The freshness overlay ───────────────────────────────────────────────────────────
  //
  // The corpus on this page is as it stood at the last nightly export. One query asks for
  // anything newer; whatever comes back is prepended and marked. Everything about it fails
  // quietly — see src/lib/fresh.ts — because the page is already correct without it and an
  // error message about a database, on a page that is showing its content, would teach
  // readers this site depends on something it does not.

  if (!filters) {
    // The empty corpus. Nothing to filter, so the fresh cards go into their own container
    // and the "nothing has been published yet" message steps aside.
    void overlay(() => {
      const only = document.querySelector<HTMLElement>('[data-fresh-only]');
      const empty = document.querySelector<HTMLElement>('[data-empty-state]');
      if (only) only.hidden = false;
      if (empty) empty.hidden = true;
    });
  }

  async function overlay(absorb: (added: HTMLElement[]) => void): Promise<void> {
    const since = document.querySelector<HTMLElement>('[data-corpus]')?.dataset.exportedAt;
    const results = document.querySelector<HTMLElement>('[data-results]');
    const template = document.querySelector<HTMLTemplateElement>('[data-fresh-card]');

    // No manifest means no export, so there is no "since" to ask about and nothing on the
    // page for an answer to be newer than.
    if (!since || !results || !template) return;

    const fresh = await reportsSince(since);
    if (fresh.length === 0) return;

    const added = fresh.map((report) => card(template, report));
    results.prepend(...added);
    absorb(added);
  }

  function card(template: HTMLTemplateElement, report: FreshReport): HTMLElement {
    const node = (template.content.cloneNode(true) as DocumentFragment)
      .firstElementChild as HTMLElement;

    // The same attributes ReportCard writes, because the filter and sort code reads the
    // element rather than any data behind it. A card missing one of these would quietly
    // fail to match a filter it should have matched.
    node.dataset.area = report.area;
    node.dataset.taskType = report.taskType;
    node.dataset.outcome = report.outcome;
    node.dataset.tools = report.tools
      .map((tool) => tool.name.trim().toLowerCase())
      .join('|');
    node.dataset.toolsNames = report.tools.map((tool) => tool.name.trim()).join('|');
    node.dataset.tags = report.tags.join('|');
    node.dataset.created = report.createdAt;
    node.dataset.confirmed = '';
    node.dataset.confirmations = '0';
    node.dataset.interactions = '0';

    // Nothing this new has been confirmed by anyone, so the square is open and the status is
    // `unverified` — which is what the template already renders. Only the outcome colour and
    // the two labels are per-card.
    const tombstone = node.querySelector<HTMLElement>('.tombstone');
    if (tombstone) {
      tombstone.dataset.outcome = report.outcome;
      tombstone.setAttribute('aria-label', tombstoneName('unverified', report.outcome));
      const label = tombstone.querySelector<HTMLElement>('.tombstone__label');
      if (label) label.textContent = OUTCOME[report.outcome].label;
    }

    const titleLink = node.querySelector<HTMLAnchorElement>('[data-title]');
    if (titleLink) {
      titleLink.textContent = report.title;
      titleLink.href = `view/?id=${report.id}`;
    }
    put(node, '[data-date]', longDate(report.createdAt));
    put(node, '[data-aim]', report.aim);
    put(node, '[data-area]', areaLabel(report.area));
    put(node, '[data-task]', taskTypeLabel(report.taskType));

    // Linked, and to /authors/view/ rather than /authors/<id>/. Author pages are generated
    // from the corpus, so the author of a report this new frequently has no static page —
    // it is often their first submission. Same reasoning as the title link above.
    const author = node.querySelector<HTMLElement>('[data-author]');
    if (author) {
      if (report.authorName && report.authorId) {
        const link = document.createElement('a');
        link.href = path(`/authors/view/?id=${report.authorId}`);
        link.textContent = report.authorName;
        author.append(link);
      } else {
        const erased = document.createElement('span');
        erased.className = 'card__erased';
        erased.textContent = 'Author since erased';
        author.append(erased);
      }
    }

    const tools = node.querySelector<HTMLElement>('[data-tools]');
    if (tools) {
      for (const tool of report.tools) tools.append(chip(tool.name, tool.version));
      for (const tag of report.tags) tools.append(chip(tag, null, true));
    }

    return node;
  }

  function put(root: HTMLElement, selector: string, text: string): void {
    const element = root.querySelector<HTMLElement>(selector);
    if (element) element.textContent = text;
  }

  /** A tool or tag chip. Built rather than cloned, because `.tool-chip` is a global class in
   *  corpus.css — the report page uses it too — so a created element is styled correctly. */
  function chip(name: string, version: string | null, isTag = false): HTMLElement {
    const item = document.createElement('li');
    item.className = isTag ? 'tool-chip tool-chip--tag' : 'tool-chip';

    const label = document.createElement('span');
    label.className = 'tool-chip__name';
    label.textContent = name;
    item.append(label);

    if (version) {
      const number = document.createElement('span');
      number.className = 'tool-chip__version';
      number.textContent = version;
      item.append(number);
    }

    return item;
  }
</script>

<style>
  /* `.card__fresh` is now in corpus.css — both reports and entries use it. */

  /* The container the overlay uses when the corpus is empty. It has no filters and no
     results head, so it needs the top rule that .listing would otherwise provide. */
  .listing--fresh {
    margin-block-end: var(--space-xl);
  }
</style>
